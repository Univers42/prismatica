# BuildKit per-Dockerfile ignore — applies ONLY to the web image build and
# replaces the root .dockerignore for it. The context is the monorepo ROOT, so
# this is an allowlist: only apps/opposite-osiris is sent, minus what the
# `astro build` does not read.
*
!apps/opposite-osiris
**/node_modules
**/.git
**/dist
**/.astro
**/*.log

# Host-specific env files (the image regenerates .env.production.local from ARGs).
**/.env.local
**/.env.*.local

# Trees of this app that are not build inputs.
apps/opposite-osiris/.agents
apps/opposite-osiris/.claude
apps/opposite-osiris/.github
apps/opposite-osiris/.vscode
apps/opposite-osiris/deploy
apps/opposite-osiris/docs
apps/opposite-osiris/test-results
apps/opposite-osiris/vault
apps/opposite-osiris/scratch_links.txt
