---
// Every page's document: SEO and social metadata, the one preloaded font, the pre-paint theme
// script, and the page chrome (header, footer, announcer) unless a page opts out with bare.
import '../styles/main.scss';
import favicon from '../assets/brand/favicon.svg';
import SiteFooter from '../components/site/SiteFooter.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import { authConfig } from '../lib/auth-config';
import prepaint from '../scripts/prepaint.js?raw';

type Props = {
	title?: string;
	description?: string;
	image?: string;
	noindex?: boolean;
	bare?: boolean;
	referrerPolicy?: string;
	jsonLd?: Record<string, unknown>[];
};

const {
	title = 'Prismatica: one workspace for every department',
	description = 'Prismatica keeps pages, databases and the links between them in one workspace, so a customer, their deals, invoices and the notes behind each decision are one record every department reads.',
	image,
	noindex = false,
	bare = false,
	referrerPolicy,
	jsonLd = [],
} = Astro.props;

const site = Astro.site;
const canonicalUrl = site ? new URL(Astro.url.pathname, site).href : undefined;
const socialImage = image ?? favicon.src;
const socialImageUrl = site ? new URL(socialImage, site).href : socialImage;
const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{ '@type': 'Organization', name: 'Prismatica', url: site?.href, logo: socialImageUrl },
		{ '@type': 'WebSite', name: 'Prismatica', url: site?.href, description },
		...jsonLd,
	],
};

const turnstileSiteKey = authConfig.turnstileSiteKey;
// Astro emits the production CSP (astro.config.mjs security.csp) with a hash for every inline
// script and style it bundles; the config adds the pre-paint script's hash itself. It injects
// none during `astro dev`, so this HMR-friendly policy stands in there.
const isDev = import.meta.env.DEV;
const developmentCsp = [
	"default-src 'self'",
	"base-uri 'self'",
	"object-src 'none'",
	"form-action 'self'",
	"frame-src https://challenges.cloudflare.com",
	"img-src 'self' data: blob:",
	"media-src 'self' data: blob:",
	"font-src 'self'",
	"style-src 'self' 'unsafe-inline'",
	"script-src 'self' 'unsafe-inline' 'unsafe-eval' https://challenges.cloudflare.com",
	"connect-src 'self' http://localhost:* https://localhost:* ws://localhost:* wss://localhost:*",
].join('; ');
// CI's deploy job polls for this to know the site serves the commit it just gated.
const buildSha = process.env.VERCEL_GIT_COMMIT_SHA ?? 'local';
// develop builds are the beta channel (prismatica-beta.vercel.app); testers see which commit they test.
const isBeta = process.env.VERCEL_GIT_COMMIT_REF === 'develop';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		{referrerPolicy && <meta name="referrer" content={referrerPolicy} />}
		<meta name="color-scheme" content="light dark" />
		<meta name="theme-color" content="#f6f5f1" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#111114" media="(prefers-color-scheme: dark)" />
		<title>{title}</title>
		<meta name="description" content={description} />
		{canonicalUrl && !noindex && <link rel="canonical" href={canonicalUrl} />}
		{noindex && <meta name="robots" content="noindex, nofollow" />}

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Prismatica" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
		<meta property="og:image" content={socialImageUrl} />
		<meta name="twitter:card" content="summary_large_image" />
		<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />

		<meta name="prismatica-build" content={buildSha} />
		<meta name="prismatica-csp-mode" content={isDev ? 'development' : 'production'} />
		{isDev && <meta http-equiv="Content-Security-Policy" content={developmentCsp} />}
		<link rel="icon" type="image/svg+xml" href={favicon.src} />
		<link rel="preload" href="/fonts/instrument-serif-latin.woff2" as="font" type="font/woff2" crossorigin />
		{turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>}

		<script is:inline set:html={prepaint} />
	</head>
	<body>
		<a href="#main-content" class="skip-link">Skip to main content</a>
		<div id="global-announcer" class="visually-hidden" aria-live="polite" aria-atomic="true"></div>
		{!bare && <SiteHeader />}
		<slot />
		{!bare && <SiteFooter />}
		{isBeta && <p class="beta-badge">Beta · {buildSha.slice(0, 7)}</p>}
		<script src="../scripts/main.ts"></script>
	</body>
</html>

<style>
	.beta-badge {
		position: fixed;
		inset-block-end: 0.75rem;
		inset-inline-start: 0.75rem;
		z-index: 1000;
		margin: 0;
		padding: 0.25rem 0.6rem;
		border-radius: 999px;
		background: #111;
		color: #fff;
		font: 600 0.75rem/1.2 system-ui, sans-serif;
		pointer-events: none;
	}
</style>
