---
import '../styles/main.scss';
import favicon from '../assets/brand/favicon.svg';
import ConsentBanner from '../components/gdpr/ConsentBanner.astro';
import { authConfig } from '../lib/auth-config';
import { DEFAULT_LOCALE, SUPPORTED_LOCALES, t, type SupportedLocale } from '../lib/i18n';
import { normalizeLocale, getLocaleDirection } from '../lib/locale';

type Props = {
	title?: string;
	description?: string;
	image?: string;
	canonical?: string;
	noindex?: boolean;
	referrerPolicy?: string;
	locale?: string;
};

const {
	title = 'Prismatica — Everything. One Space.',
	description = 'Prismatica is the workspace that grows from one note to a full operating system: notes, dashboards, databases, apps, drawing and collaboration in one place.',
	image,
	canonical,
	noindex = false,
	referrerPolicy,
	locale = DEFAULT_LOCALE,
} = Astro.props;

const activeLocale = normalizeLocale(locale, {
	defaultLocale: DEFAULT_LOCALE,
	supportedLocales: SUPPORTED_LOCALES,
}) as SupportedLocale;

const direction = getLocaleDirection(activeLocale);

// Absolute URLs for canonical + social cards (Astro.site comes from astro.config).
const site = Astro.site;
const canonicalUrl = canonical ?? (site ? new URL(Astro.url.pathname, site).href : undefined);
const socialImage = image ?? favicon.src;
const socialImageUrl = site ? new URL(socialImage, site).href : socialImage;
const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{ '@type': 'Organization', name: 'Prismatica', url: site?.href, logo: socialImageUrl },
		{ '@type': 'WebSite', name: 'Prismatica', url: site?.href, description },
	],
};

const turnstileSiteKey = authConfig.turnstileSiteKey;
// Production CSP is generated by Astro's `security.csp` (see astro.config.mjs):
// a per-page <meta> carrying SHA-256 hashes for every inline script/style Astro
// emits, so `script-src` stays strict ('self' + hashes, no 'unsafe-inline').
// Astro does NOT inject a CSP during `astro dev`, so we emit this HMR-friendly
// policy ourselves there (unsafe-inline/eval + ws: for Vite's live reload).
const isDev = import.meta.env.DEV;
const developmentCsp = [
	"default-src 'self'",
	"base-uri 'self'",
	"object-src 'none'",
	// frame-ancestors omitted on purpose: ignored in <meta>, set as HTTP header by the proxy.
	"form-action 'self'",
	"frame-src https://challenges.cloudflare.com",
	"img-src 'self' data: blob:",
	"media-src 'self' data: blob:",
	"worker-src 'self' blob:",
	"manifest-src 'self'",
	"font-src 'self'",
	"style-src 'self' 'unsafe-inline'",
	"script-src 'self' 'unsafe-inline' 'unsafe-eval' https://challenges.cloudflare.com",
	"connect-src 'self' http://localhost:* https://localhost:* ws://localhost:* wss://localhost:*",
].join('; ');
// CI's deploy job polls for this to know production serves the commit it just gated.
const buildSha = process.env.VERCEL_GIT_COMMIT_SHA ?? 'local';
// develop builds are the beta channel (prismatica-beta.vercel.app); testers see which commit they test.
const isBeta = process.env.VERCEL_GIT_COMMIT_REF === 'develop';
---

<!doctype html>
<html lang={activeLocale} dir={direction} data-theme="swiss">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		{referrerPolicy && <meta name="referrer" content={referrerPolicy} />}
		<meta name="color-scheme" content="light dark" />
		<meta name="theme-color" content="#ffffff" />
		<meta name="description" content={description} />
		{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
		{noindex && <meta name="robots" content="noindex, nofollow" />}

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Prismatica" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
		<meta property="og:image" content={socialImageUrl} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageUrl} />
		<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />

		<meta name="prismatica-build" content={buildSha} />
		<meta name="prismatica-csp-mode" content={isDev ? 'development' : 'production'} />
		{isDev && <meta http-equiv="Content-Security-Policy" content={developmentCsp} />}
		<link rel="icon" type="image/svg+xml" href={favicon.src} />
		<link rel="preload" href="/fonts/space-grotesk.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/instrument-serif.woff2" as="font" type="font/woff2" crossorigin />
		{turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>}
		<title>{title}</title>
	</head>
	<body>
		<!-- Bypass block (WCAG 2.4.1): lives in the layout so every page has it,
		     not just the home page. Targets the per-page <main id="main-content">. -->
		<a href="#main-content" class="skip-link" data-i18n="a11y.skipToContent">{t(activeLocale, 'a11y.skipToContent')}</a>
		<!-- Global screen-reader live region (WCAG 4.1.3): page scripts announce
		     dynamic state changes here (theme switch, consent saves, auth results). -->
		<div aria-live="polite" aria-atomic="true" class="visually-hidden" id="global-announcer"></div>
		<!-- Animated aurora backdrop — decorative; gives the glass panels something
		     to refract. Fixed, behind everything, pointer-events:none, and frozen
		     under prefers-reduced-motion (see _premium.scss). -->
		<div class="aurora-bg" aria-hidden="true">
			<span class="aurora-bg__blob aurora-bg__blob--a"></span>
			<span class="aurora-bg__blob aurora-bg__blob--b"></span>
			<span class="aurora-bg__blob aurora-bg__blob--c"></span>
		</div>
		<slot />
		<!-- Consent lives in the layout so the choice can be reviewed or withdrawn from every
		     page (GDPR Art. 7(3)), including the "Manage cookie preferences" controls. -->
		<ConsentBanner />
		{isBeta && <p class="beta-badge">Beta · {buildSha.slice(0, 7)}</p>}
		<!-- premium.ts is imported by main.ts (a second bundled <script src> in
		     this layout was dropped by Astro's script hoisting). -->
		<script src="../scripts/main.ts"></script>
	</body>
</html>

<style>
	.beta-badge {
		position: fixed;
		inset-block-end: 0.75rem;
		inset-inline-start: 0.75rem;
		z-index: 1000;
		margin: 0;
		padding: 0.25rem 0.6rem;
		border-radius: 999px;
		background: #111;
		color: #fff;
		font: 600 0.75rem/1.2 system-ui, sans-serif;
		pointer-events: none;
	}
</style>
