---
// Every page's document: SEO and social metadata, the one preloaded font, the pre-paint script,
// the consent banner, and the page chrome (header, footer, announcer) unless a page opts out with
// bare.
import '../styles/main.scss';
import favicon from '../assets/brand/favicon.svg';
import ConsentBanner from '../components/gdpr/ConsentBanner.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import { authConfig } from '../lib/auth-config';
import { DEFAULT_LOCALE, SUPPORTED_LOCALES, t, type SupportedLocale } from '../lib/i18n';
import { normalizeLocale, getLocaleDirection } from '../lib/locale';
import prepaint from '../scripts/prepaint.js?raw';

type Props = {
	title?: string;
	titleKey?: string;
	description?: string;
	image?: string;
	canonical?: string;
	noindex?: boolean;
	referrerPolicy?: string;
	locale?: string;
	bare?: boolean;
	jsonLd?: Record<string, unknown>[];
};

const {
	title,
	titleKey = title ? undefined : 'site.meta.landingTitle',
	description = 'Prismatica keeps pages, databases and the links between them in one workspace, so a customer, their deals, invoices and the notes behind each decision are one record every department reads.',
	image,
	canonical,
	noindex = false,
	referrerPolicy,
	locale = DEFAULT_LOCALE,
	bare = false,
	jsonLd = [],
} = Astro.props;

const activeLocale = normalizeLocale(locale, {
	defaultLocale: DEFAULT_LOCALE,
	supportedLocales: SUPPORTED_LOCALES,
}) as SupportedLocale;

const direction = getLocaleDirection(activeLocale);
const pageTitle = titleKey ? t(activeLocale, titleKey) : title;

const site = Astro.site;
const canonicalUrl = canonical ?? (site ? new URL(Astro.url.pathname, site).href : undefined);
const socialImage = image ?? favicon.src;
const socialImageUrl = site ? new URL(socialImage, site).href : socialImage;
const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{ '@type': 'Organization', name: 'Prismatica', url: site?.href, logo: socialImageUrl },
		{ '@type': 'WebSite', name: 'Prismatica', url: site?.href, description },
		...jsonLd,
	],
};

const turnstileSiteKey = authConfig.turnstileSiteKey;
// Astro emits the production CSP (astro.config.mjs security.csp) with a hash for every inline
// script and style it bundles; the config adds the pre-paint script's hash itself. It injects
// none during `astro dev`, so this HMR-friendly policy stands in there.
const isDev = import.meta.env.DEV;
const developmentCsp = [
	"default-src 'self'",
	"base-uri 'self'",
	"object-src 'none'",
	// frame-ancestors omitted on purpose: ignored in <meta>, set as HTTP header by the proxy.
	"form-action 'self'",
	"frame-src https://challenges.cloudflare.com",
	"img-src 'self' data: blob:",
	"media-src 'self' data: blob:",
	"worker-src 'self' blob:",
	"manifest-src 'self'",
	"font-src 'self'",
	"style-src 'self' 'unsafe-inline'",
	"script-src 'self' 'unsafe-inline' 'unsafe-eval' https://challenges.cloudflare.com",
	"connect-src 'self' http://localhost:* https://localhost:* ws://localhost:* wss://localhost:*",
].join('; ');
// CI's deploy job polls for this to know production serves the commit it just gated.
const buildSha = process.env.VERCEL_GIT_COMMIT_SHA ?? 'local';
// develop builds are the beta channel (prismatica-beta.vercel.app); testers see which commit they test.
const isBeta = process.env.VERCEL_GIT_COMMIT_REF === 'develop';
---

<!doctype html>
<html lang={activeLocale} dir={direction}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		{referrerPolicy && <meta name="referrer" content={referrerPolicy} />}
		<meta name="color-scheme" content="light dark" />
		<meta name="theme-color" content="#f6f5f1" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#111114" media="(prefers-color-scheme: dark)" />
		<title data-i18n={titleKey}>{pageTitle}</title>
		<meta name="description" content={description} />
		{canonicalUrl && !noindex && <link rel="canonical" href={canonicalUrl} />}
		{noindex && <meta name="robots" content="noindex, nofollow" />}

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Prismatica" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
		<meta property="og:image" content={socialImageUrl} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageUrl} />
		<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />

		<meta name="prismatica-build" content={buildSha} />
		<meta name="prismatica-csp-mode" content={isDev ? 'development' : 'production'} />
		{isDev && <meta http-equiv="Content-Security-Policy" content={developmentCsp} />}
		<link rel="icon" type="image/svg+xml" href={favicon.src} />
		<link rel="preload" href="/fonts/instrument-serif-latin.woff2" as="font" type="font/woff2" crossorigin />
		{turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>}

		<script is:inline set:html={prepaint} />
	</head>
	<body>
		<a href="#main-content" class="skip-link" data-i18n="a11y.skipToContent">{t(activeLocale, 'a11y.skipToContent')}</a>
		<div id="global-announcer" class="visually-hidden" aria-live="polite" aria-atomic="true"></div>
		{!bare && <SiteHeader locale={activeLocale} />}
		<slot />
		{!bare && <SiteFooter locale={activeLocale} />}
		<!-- Consent lives in the layout so the choice can be reviewed or withdrawn from every
		     page (GDPR Art. 7(3)), including the "Manage cookie preferences" controls. -->
		<ConsentBanner locale={activeLocale} />
		{isBeta && <p class="beta-badge">Beta · {buildSha.slice(0, 7)}</p>}
		<script src="../scripts/main.ts"></script>
	</body>
</html>

<style>
	.beta-badge {
		position: fixed;
		inset-block-end: 0.75rem;
		inset-inline-start: 0.75rem;
		z-index: 1000;
		margin: 0;
		padding: 0.25rem 0.6rem;
		border-radius: 999px;
		background: #111;
		color: #fff;
		font: 600 0.75rem/1.2 system-ui, sans-serif;
		pointer-events: none;
	}
</style>
