---
import Layout from '../../layouts/Layout.astro';
import { CSRF_STORAGE_KEY, NEWSLETTER_INTENT_KEY, POLICY_LAST_UPDATED, POLICY_VERSION } from '../../data/legal';
---

<Layout title="Cookie Policy | Prismatica" description="Prismatica cookie and local storage policy.">
	<main id="main-content" class="page-main">
		<div class="container prose">
			<h1>Cookie Policy</h1>
			<p><strong>Version:</strong> {POLICY_VERSION} · <strong>Last updated:</strong> {POLICY_LAST_UPDATED}</p>
			<p>Prismatica uses two cookies, both for sign-in and features you use, and stores preferences in your browser's local storage. It loads no analytics or marketing scripts, so there is nothing to consent to and no consent banner.</p>

			<div class="table-scroll" role="region" aria-label="Cookies and browser storage keys" tabindex="0">
			<table class="legal-table">
				<thead>
					<tr><th>Name</th><th>Type</th><th>Purpose</th><th>Lifetime</th><th>Consent required?</th></tr>
				</thead>
				<tbody>
					<tr><td>prismatica_refresh</td><td>Cookie (HttpOnly, sent only to the sign-in service)</td><td>Keeps you signed in by renewing your session.</td><td>30 days, or until you sign out.</td><td>No, strictly necessary for sign-in.</td></tr>
					<tr><td>osio_ide_preview</td><td>Cookie (HttpOnly, workspace code preview only)</td><td>Authorises the preview of your workspace code sandbox.</td><td>1 hour.</td><td>No, strictly necessary for that feature.</td></tr>
					<tr><td>prismatica-theme</td><td>localStorage</td><td>Stores your theme: light, dark, or match the system.</td><td>Until cleared or changed.</td><td>No, strictly necessary preference.</td></tr>
					<tr><td>{NEWSLETTER_INTENT_KEY}</td><td>localStorage</td><td>Stores unauthenticated newsletter opt-in intent until login sync.</td><td>Until sync or manual clearing.</td><td>Yes, newsletter consent.</td></tr>
					<tr><td>{CSRF_STORAGE_KEY}</td><td>localStorage</td><td>Stores a CSRF nonce for the public data-rights form.</td><td>Until cleared.</td><td>No, security necessity.</td></tr>
					<tr><td>osio:* and osionos* keys</td><td>localStorage (workspace)</td><td>Your signed-in workspace session, a cache of your pages, favourites, contacts, unread counts and pending edits, and workspace settings.</td><td>Until cleared.</td><td>No, strictly necessary for the workspace.</td></tr>
				</tbody>
			</table>
			</div>
		</div>
	</main>
</Layout>
