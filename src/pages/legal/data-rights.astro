---
import Layout from '../../layouts/Layout.astro';
import { DATA_CONTROLLER, POLICY_LAST_UPDATED, POLICY_VERSION } from '../../data/legal';
---

<Layout title="Data Rights — Prismatica" description="Manage your account data and submit GDPR data rights requests to Prismatica.">
	<main id="main-content" class="legal-page section-shell">
		<a href="/" class="legal-page__back">← Back to Prismatica</a>
		<h1>Data Rights &amp; Account Data</h1>
		<p><strong>Version:</strong> {POLICY_VERSION} · <strong>Last updated:</strong> {POLICY_LAST_UPDATED}</p>
		<p>Use this page to exercise your data rights. Account actions require an authenticated session; requests submitted below are not an automatic export or deletion and may require identity verification.</p>

		<section aria-labelledby="account-data-title">
			<h2 id="account-data-title">Manage account data</h2>
			<p>Export a portable copy of the personal data associated with your signed-in account, or request account deletion. These actions are sent to the backend with your current session. Review the result and save any export before leaving this page.</p>
			<div class="data-rights-actions" data-gdpr-self-service>
				<button class="button button--primary" type="button" data-gdpr-export>Export my data</button>
				<button class="button button--ghost" type="button" data-gdpr-delete>Request account deletion</button>
				<output class="form-status" aria-live="polite" role="status" data-gdpr-self-service-status></output>
			</div>
			<p class="form-note">Deletion is a consequential action. You will be asked to confirm it before the request is submitted. The backend remains responsible for verifying identity, deleting or anonymising related data, and applying any legally required retention.</p>
		</section>

		<section aria-labelledby="rights-request-title">
			<h2 id="rights-request-title">Other data rights requests</h2>
			<p>Use this form to request access, correction, erasure, portability, restriction or objection, or to withdraw consent. Unauthenticated requests are recorded for manual verification before any disclosure or deletion.</p>
			<form class="data-rights-form" data-gdpr-request-form novalidate>
				<input type="hidden" name="csrf" data-csrf-token />
				<div class="field">
					<label for="rights-email">Email address</label>
					<input id="rights-email" name="email" type="email" autocomplete="email" required />
				</div>
				<div class="field">
					<label for="rights-type">Request type</label>
					<select id="rights-type" name="request_type" required>
						<option value="access">Access my data</option>
						<option value="deletion">Delete my account/data</option>
						<option value="rectification">Correct my data</option>
						<option value="portability">Export portable data</option>
						<option value="restriction">Restrict processing</option>
						<option value="objection">Object to processing</option>
						<option value="withdrawal">Withdraw consent</option>
					</select>
				</div>
				<div class="field">
					<label for="rights-message">Additional details</label>
					<textarea id="rights-message" name="message" rows="5" maxlength="1000"></textarea>
				</div>
				<p class="form-note">We may request proof of identity before processing your request. The normal response period is one month.</p>
				<button class="button button--primary" type="submit" aria-label="Submit data rights request">Submit request</button>
				<output class="form-status" aria-live="polite" data-gdpr-request-status></output>
			</form>
		</section>

		<p>Alternatively, contact <a href={`mailto:${DATA_CONTROLLER.email}`}>{DATA_CONTROLLER.email}</a>.</p>
	</main>
</Layout>
