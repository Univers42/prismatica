---
import Layout from '../layouts/Layout.astro';
import HeaderNew from '../components/sections/HeaderNew.astro';
import FooterNew from '../components/sections/FooterNew.astro';
---

<Layout>
	<HeaderNew />
	<main id="main-content" class="swipe-stack" style="min-height: 60vh; display: flex; align-items: center; justify-content: center; text-align: center; padding: 2rem;">
		<div>
			<h1>Documentation</h1>
			<p>Our documentation is currently being written. Please check back soon!</p>
			<a href="/" style="display: inline-block; margin-top: 1rem; text-decoration: underline;">Return to Home</a>
		</div>
	</main>
	<FooterNew />
</Layout>
