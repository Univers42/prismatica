---
import AppTour from '../components/sections/AppTour.astro';
import BackendArchitecture from '../components/sections/BackendArchitecture.astro';
import CanvasWindowsSection from '../components/sections/CanvasWindowsSection.astro';
import DocsTeaser from '../components/sections/DocsTeaser.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import FeatureTrio from '../components/sections/FeatureTrio.astro';
import FinalCta from '../components/sections/FinalCta.astro';
import FooterNew from '../components/sections/FooterNew.astro';
import HeaderNew from '../components/sections/HeaderNew.astro';
import HeroNew from '../components/sections/HeroNew.astro';
import LogoStrip from '../components/sections/LogoStrip.astro';
import Pricing from '../components/sections/Pricing.astro';
import SocialProof from '../components/sections/SocialProof.astro';
import MascotDock from '../components/layout/MascotDock.astro';
import StoryStage from '../components/layout/StoryStage.astro';
import Notification from '../components/ui/Notification.astro';
import ConsentBanner from '../components/gdpr/ConsentBanner.astro';
import Layout from '../layouts/Layout.astro';

const requestedLocale = Astro.url.searchParams.get('lang') ?? undefined;
---

<Layout title="Prismatica — All your business apps, connected in one space" locale={requestedLocale}>
	<div aria-live="polite" aria-atomic="true" class="visually-hidden" id="global-announcer"></div>
	<Notification />
	<HeaderNew locale={requestedLocale} />
	<StoryStage />
	<main id="main-content" class="swipe-stack" data-swipe-stack>
		<section class="swipe-stack__scene" data-stage="hero"><div class="swipe-stack__card swipe-stack__card--hero"><div class="swipe-stack__hero-combo"><HeroNew locale={requestedLocale} /><LogoStrip locale={requestedLocale} /></div></div></section>
		<section class="swipe-stack__scene" data-stage="apps"><div class="swipe-stack__card"><AppTour /></div></section>
		<section class="swipe-stack__scene" data-stage="product"><div class="swipe-stack__card"><FeatureTrio locale={requestedLocale} /></div></section>
		<section class="swipe-stack__scene" data-stage="canvas"><div class="swipe-stack__card"><CanvasWindowsSection /></div></section>
		<section class="swipe-stack__scene" data-stage="architecture"><div class="swipe-stack__card"><BackendArchitecture /></div></section>
		<section class="swipe-stack__scene" data-stage="proof"><div class="swipe-stack__card"><SocialProof locale={requestedLocale} /></div></section>
		<section class="swipe-stack__scene" data-stage="pricing"><div class="swipe-stack__card"><Pricing /></div></section>
		<section class="swipe-stack__scene" data-stage="docs"><div class="swipe-stack__card"><DocsTeaser locale={requestedLocale} /></div></section>
		<section class="swipe-stack__scene" data-stage="faq"><div class="swipe-stack__card"><FaqSection locale={requestedLocale} /></div></section>
		<section class="swipe-stack__scene" data-stage="cta"><div class="swipe-stack__card"><FinalCta locale={requestedLocale} /></div></section>
	</main>
	<div class="swipe-stack__tail"><FooterNew /></div>
	<ConsentBanner />
	<MascotDock />
</Layout>

