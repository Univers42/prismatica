---
// The story, in the order of groot docs/redesign/PLAN.md §1: claim, problem, fix, views, learning,
// where it runs, what it is plainly, and the call to action. A section that does not serve the
// story is cut rather than added here.
import Layout from '../layouts/Layout.astro';
import FinalCta from '../components/site/FinalCta.astro';
import Hero from '../components/site/Hero.astro';
import Learning from '../components/site/Learning.astro';
import OneRecord from '../components/site/OneRecord.astro';
import Plainly from '../components/site/Plainly.astro';
import RunIt from '../components/site/RunIt.astro';
import Silo from '../components/site/Silo.astro';
import TourDialog from '../components/site/TourDialog.astro';
import Views from '../components/site/Views.astro';

const softwareApplication = {
	'@type': 'SoftwareApplication',
	name: 'Prismatica',
	applicationCategory: 'BusinessApplication',
	operatingSystem: 'Web, Linux, Windows',
	description: 'One workspace for pages, databases and the links between them, shared by every department.',
};
---

<Layout jsonLd={[softwareApplication]}>
	<main id="main-content">
		<Hero />
		<Silo />
		<OneRecord />
		<Views />
		<Learning />
		<RunIt />
		<Plainly />
		<FinalCta />
	</main>
	<TourDialog />
</Layout>
