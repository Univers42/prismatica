---
// The reset email's link lands here (src/scripts/auth-reset.ts). The rule list is rendered now and
// only restyled while typing, so the card never shifts.
import Layout from '../../layouts/Layout.astro';
import { passwordRuleResults } from '../../lib/auth-validation';

const rules = passwordRuleResults('');
---

<Layout title="Choose a new password · Prismatica" description="Choose a new Prismatica password from a reset email link." noindex>
	<main id="main-content" class="auth-page" data-password-reset>
		<section class="auth-card" aria-labelledby="reset-title">
			<p class="label">Password reset</p>
			<h1 id="reset-title">Choose a new password</h1>
			<noscript><p>Changing your password needs JavaScript, which is off in this browser. Turn it on and open the link from your email again.</p></noscript>
			<form class="auth-form" data-reset-form data-when="form" novalidate>
				<div class="field">
					<label for="new-password">New password</label>
					<div class="password-control">
						<input id="new-password" name="password" type="password" autocomplete="new-password" required minlength="8" aria-describedby="reset-rules" />
						<button class="password-control__toggle" type="button" data-password-toggle aria-label="Show new password" aria-controls="new-password" aria-pressed="false" title="Show new password">
							<span aria-hidden="true">◉</span>
						</button>
					</div>
					<div class="password-strength" data-password-strength data-strength-level="empty">
						<div class="password-strength__meter" aria-hidden="true">
							<span class="password-strength__segment" data-password-segment></span>
							<span class="password-strength__segment" data-password-segment></span>
							<span class="password-strength__segment" data-password-segment></span>
							<span class="password-strength__segment" data-password-segment></span>
						</div>
						<span class="password-strength__label" data-password-strength-label>Enter a password</span>
						<ul id="reset-rules" class="password-strength__rules" data-password-rules>
							{rules.map((rule) => <li class="password-strength__rule is-unmet">{rule.label}</li>)}
						</ul>
					</div>
				</div>
				<div class="field">
					<label for="confirm-password">Repeat the new password</label>
					<div class="password-control">
						<input id="confirm-password" name="confirm_password" type="password" autocomplete="new-password" required minlength="8" aria-describedby="reset-password-match" />
						<button class="password-control__toggle" type="button" data-password-toggle aria-label="Show the repeated password" aria-controls="confirm-password" aria-pressed="false" title="Show the repeated password">
							<span aria-hidden="true">◉</span>
						</button>
					</div>
					<p id="reset-password-match" class="password-match" data-password-match aria-live="polite">Repeat the same password.</p>
				</div>
				<div class="field" data-reset-code-field hidden>
					<label for="reset-code">Code from your authenticator app</label>
					<input id="reset-code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" />
				</div>
				<button class="button button--primary" type="submit" disabled>Change password</button>
			</form>
			<p data-auth-status role="status"></p>
			<div class="auth-card__actions">
				<button class="button button--primary" type="button" data-open-connect data-when="done" hidden>Sign in</button>
				<button class="button button--primary" type="button" data-open-portal="recovery" data-when="refused" hidden>Ask for a new link</button>
				<a class="text-link" href="/">Back to the homepage</a>
			</div>
		</section>
	</main>
	<script>
		import { useAuth } from '../../hooks/useAuth';
		import { bindResetPage } from '../../scripts/auth-reset';
		import { bindPasswordToggles } from '../../scripts/password-toggle';

		const root = document.querySelector<HTMLElement>('[data-password-reset]');
		if (root) {
			bindPasswordToggles(root);
			bindResetPage(root, useAuth(), window.location, window.history);
		}
	</script>
</Layout>
