---
import Layout from '../../layouts/Layout.astro';
import AuthResult from '../../components/ui/AuthResult.astro';
---

<Layout title="Reset your Prismatica password" description="Choose a new Prismatica password from a recovery email link." noindex>
	<main id="main-content" class="auth-page" data-password-reset>
		<section class="auth-card" aria-labelledby="reset-title" data-reset-card>
			<p class="eyebrow">Password recovery</p>
			<h1 id="reset-title">Choose a new password</h1>
			<p class="auth-card__hint">Use at least 8 characters with uppercase, lowercase, number, and symbol.</p>
			<form class="auth-form" data-reset-form novalidate>
				<div class="field">
					<label for="new-password">New password</label>
					<div class="password-control">
						<input id="new-password" name="password" type="password" autocomplete="new-password" required minlength="8" />
						<button class="password-control__toggle" type="button" data-password-toggle aria-label="Show new password" aria-controls="new-password" aria-pressed="false" title="Show new password">
							<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z"></path><circle cx="12" cy="12" r="3"></circle><path class="portal-eye__slash" d="M4 20L20 4"></path></svg>
						</button>
					</div>
					<div class="password-strength" data-password-strength data-strength-level="empty" aria-live="polite">
						<div class="password-strength__meter" aria-hidden="true">
							<span class="password-strength__segment" data-password-segment></span>
							<span class="password-strength__segment" data-password-segment></span>
							<span class="password-strength__segment" data-password-segment></span>
							<span class="password-strength__segment" data-password-segment></span>
						</div>
						<span class="password-strength__label" data-password-strength-label>Enter a password</span>
						<ul class="password-strength__rules" data-password-rules></ul>
					</div>
				</div>
				<div class="field">
					<label for="confirm-password">Confirm new password</label>
					<div class="password-control">
						<input id="confirm-password" name="confirm_password" type="password" autocomplete="new-password" required minlength="8" />
						<button class="password-control__toggle" type="button" data-password-toggle aria-label="Show confirmation password" aria-controls="confirm-password" aria-pressed="false" title="Show confirmation password">
							<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z"></path><circle cx="12" cy="12" r="3"></circle><path class="portal-eye__slash" d="M4 20L20 4"></path></svg>
						</button>
					</div>
					<p id="reset-password-match" class="password-match" data-password-match aria-live="polite">Repeat the same password.</p>
				</div>
				<div class="field" data-reset-code-field hidden>
					<label for="reset-code">Authenticator code</label>
					<input id="reset-code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" />
				</div>
				<button class="portal-cta" type="submit" disabled aria-label="Update password">Update password →</button>
				<output class="portal-error" data-reset-status aria-live="polite" aria-atomic="true"></output>
			</form>
			<a class="text-link" href="/">Return home</a>
		</section>
		<AuthResult id="reset-result" eyebrow="Password recovery" title="Checking your reset link…" message="" hidden />
	</main>
	<script>
		import { authConfig } from '../../lib/auth-config';
		import { gatewayMessage, postToGateway, takeLinkFragment } from '../../lib/link-fragment';
		import { checkPasswordStrength, passwordRuleResults } from '../../lib/auth-validation';
		import { showAuthResult, type AuthResult } from '../../scripts/auth-result';

		const root = document.querySelector('[data-password-reset]') as HTMLElement | null;
		const form = root?.querySelector('[data-reset-form]') as HTMLFormElement | null | undefined;
		const status = root?.querySelector('[data-reset-status]');
		// The fragment is removed from the address bar here, before any request is made. The link
		// is only spent on submit, so a reload after this point needs the e-mailed link again.
		const link = takeLinkFragment(window.location, window.history, 'recovery');
		const codeField = root?.querySelector('[data-reset-code-field]');
		const formCard = root?.querySelector<HTMLElement>('[data-reset-card]');
		const resultCard = root?.querySelector<HTMLElement>('[data-auth-result]');
		let resetTicket = '';
		const NEW_LINK_STEPS = ['Open the sign-in window and choose “Forgot password?”.', 'Enter your email address to get a new link.', 'Open the new email within the time it states, in this browser.'];
		const linkExpired = (message: string): AuthResult => ({ tone: 'notice', title: 'This reset link no longer works', message, steps: NEW_LINK_STEPS, action: 'Request a new link' });
		// The outcome replaces the form: once the link is spent or refused, the form has nothing left to do.
		const finish = (result: AuthResult) => {
			if (!resultCard) return;
			if (formCard) formCard.hidden = true;
			showAuthResult(resultCard, result);
		};
		const setStatus = (message: string, isError = false) => {
			if (!status) return;
			status.textContent = message;
			status.classList.toggle('is-error', isError);
		};
		const renderStrength = (password: string) => {
			const root = form?.querySelector('[data-password-strength]');
			if (!(root instanceof HTMLElement)) return;
			const result = checkPasswordStrength(password);
			root.dataset.strengthLevel = result.level;
			root.querySelectorAll('[data-password-segment]').forEach((segment, index) => segment.classList.toggle('is-filled', index < result.score));
			const label = root.querySelector('[data-password-strength-label]');
			if (label instanceof HTMLElement) label.textContent = result.level === 'empty' ? 'Enter a password' : `${result.level[0].toUpperCase()}${result.level.slice(1)} password`;
			const rules = root.querySelector('[data-password-rules]');
			if (rules instanceof HTMLUListElement) {
				rules.replaceChildren(...passwordRuleResults(password).map((rule) => {
					const item = document.createElement('li');
					item.className = `password-strength__rule ${rule.passed ? 'is-met' : 'is-unmet'}`;
					item.textContent = rule.label;
					return item;
				}));
			}
		};
		const updateMatch = (password: string, confirm: string) => {
			const match = form?.querySelector('[data-password-match]');
			const hasConfirmation = confirm.length > 0;
			const matches = hasConfirmation && password === confirm;
			if (match instanceof HTMLElement) {
				match.classList.toggle('is-match', matches);
				match.classList.toggle('is-mismatch', hasConfirmation && !matches);
				match.textContent = matches ? 'Passwords match.' : hasConfirmation ? 'Passwords do not match.' : 'Repeat the same password.';
			}
			return matches;
		};
		const refreshSubmitState = () => {
			if (!(form instanceof HTMLFormElement)) return;
			const password = form.elements.namedItem('password');
			const confirm = form.elements.namedItem('confirm_password');
			const button = form.querySelector('button[type="submit"]');
			if (!(password instanceof HTMLInputElement) || !(confirm instanceof HTMLInputElement) || !(button instanceof HTMLButtonElement)) return;
			renderStrength(password.value);
			button.disabled = !(checkPasswordStrength(password.value).passed && updateMatch(password.value, confirm.value) && Boolean(link));
		};
		if (!link) finish(linkExpired('Part of the link is missing, or it was already opened: reloading this page also clears it. Reset links work once.'));
		form?.querySelectorAll('input[type="password"]').forEach((input) => input.addEventListener('input', refreshSubmitState));
		refreshSubmitState();
		form?.addEventListener('submit', async (event) => {
			event.preventDefault();
			const password = form.elements.namedItem('password');
			const confirm = form.elements.namedItem('confirm_password');
			if (!(password instanceof HTMLInputElement) || !(confirm instanceof HTMLInputElement)) return;
			if (!checkPasswordStrength(password.value).passed) {
				setStatus('Your password does not meet the security requirements.', true);
				password.focus();
				return;
			}
			if (password.value !== confirm.value) {
				setStatus('Both password fields must match.', true);
				confirm.focus();
				return;
			}
			if (!link) return;
			const button = form.querySelector('button[type="submit"]');
			button?.setAttribute('disabled', '');
			setStatus('Updating your password…');
			const code = form.elements.namedItem('code');
			const payload = resetTicket
				? { reset_ticket: resetTicket, password: password.value, code: code instanceof HTMLInputElement ? code.value.trim() : '' }
				: { ...link, password: password.value };
			try {
				const answer = await postToGateway(fetch, authConfig.gatewayUrl, '/reset-password', payload);
				if (answer.status === 200) {
					resetTicket = '';
					finish({ tone: 'success', title: 'Your password is updated', message: 'Your new password is active now. Use it the next time you sign in.', steps: [], action: 'Sign in' });
					return;
				}
				if (answer.status === 410) {
					finish(linkExpired(gatewayMessage(answer, 'It has expired or was already used. Your password was not changed.')));
					return;
				}
				if (typeof answer.body.reset_ticket === 'string') resetTicket = answer.body.reset_ticket;
				if (answer.body.error === 'mfa_required' || answer.body.error === 'mfa_invalid') {
					if (codeField instanceof HTMLElement) codeField.hidden = false;
					if (code instanceof HTMLInputElement) code.focus();
				}
				setStatus(gatewayMessage(answer, 'Your password was not updated. Check the fields and try again.'), true);
				button?.removeAttribute('disabled');
			} catch {
				setStatus('The sign-in service did not answer. Try again in a minute.', true);
				button?.removeAttribute('disabled');
			}
		});
	</script>
</Layout>
