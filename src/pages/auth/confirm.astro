---
import Layout from '../../layouts/Layout.astro';
import AuthResult from '../../components/ui/AuthResult.astro';
---

<Layout title="Confirm your Prismatica account" description="Confirm your Prismatica account email address." noindex>
	<main id="main-content" class="auth-page" data-auth-confirm>
		<AuthResult id="confirm" eyebrow="Email verification" title="Confirming your email…" message="Checking the link from your email. This takes a few seconds." />
	</main>
	<script>
		import { authConfig } from '../../lib/auth-config';
		import { gatewayMessage, postToGateway, takeLinkFragment } from '../../lib/link-fragment';
		import { showAuthResult, type AuthResult } from '../../scripts/auth-result';

		const RESEND_STEP = 'Choose “Send a new link” and enter the email you signed up with.';
		const confirmed = (message: string): AuthResult => ({
			tone: 'success',
			title: 'Your email is confirmed',
			message,
			steps: [],
			action: 'Sign in',
		});
		const INCOMPLETE: AuthResult = {
			tone: 'notice',
			title: 'This confirmation link is incomplete',
			message: 'Part of the link is missing. Some mail apps cut long links, and reloading this page also clears it.',
			steps: ['Open the confirmation email and select its button again.', `Still not working? ${RESEND_STEP}`],
			action: 'Send a new link',
			portalForm: 'resend',
		};
		const refused = (message: string): AuthResult => ({
			tone: 'notice',
			title: 'This confirmation link no longer works',
			message,
			steps: ['Already confirmed your email? Then sign in as usual.', `Otherwise: ${RESEND_STEP}`, 'Open the new email within the time it states.'],
			action: 'Send a new link',
			portalForm: 'resend',
		});
		const UNREACHABLE: AuthResult = {
			tone: 'danger',
			title: 'The sign-in service did not answer',
			message: 'Your email could not be checked right now. Nothing about your account changed.',
			steps: ['Check your internet connection.', 'Open the link from your email again in a minute.'],
		};

		const card = document.querySelector<HTMLElement>('[data-auth-confirm] [data-auth-result]');
		// The fragment is removed from the address bar here, before any request is made.
		const link = takeLinkFragment(window.location, window.history, 'signup');

		async function confirmEmail(): Promise<AuthResult> {
			if (!link) return INCOMPLETE;
			const answer = await postToGateway(fetch, authConfig.gatewayUrl, '/verify', link);
			if (answer.status === 200) return confirmed(gatewayMessage(answer, 'Your Prismatica account is ready. Sign in to open your workspace.'));
			return refused(gatewayMessage(answer, 'It has expired or was already used.'));
		}

		void confirmEmail()
			.catch(() => UNREACHABLE)
			.then((result) => {
				if (card) showAuthResult(card, result);
			});
	</script>
</Layout>
