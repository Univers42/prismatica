---
// The confirmation email's link lands here (src/scripts/auth-confirm.ts). The token rides in the
// fragment and the gateway checks it; this page only carries it there and shows the next step.
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Confirm your email · Prismatica" description="Confirm the email address of your Prismatica account." noindex>
	<main id="main-content" class="auth-page" data-auth-confirm>
		<section class="auth-card" aria-labelledby="confirm-title">
			<p class="label">Email confirmation</p>
			<h1 id="confirm-title">Confirm your email</h1>
			<p data-auth-status role="status">Checking your link…</p>
			<noscript><p>Confirming needs JavaScript, which is off in this browser. Turn it on and open the link from your email again.</p></noscript>
			<div class="auth-card__actions">
				<button class="button button--primary" type="button" data-open-connect data-when="confirmed" hidden>Sign in</button>
				<button class="button button--primary" type="button" data-open-portal="resend" data-when="refused" hidden>Send a new link</button>
				<button class="button button--primary" type="button" data-confirm-retry data-when="unavailable" hidden>Try again</button>
				<a class="text-link" href="/">Back to the homepage</a>
			</div>
		</section>
	</main>
	<script>
		import { useAuth } from '../../hooks/useAuth';
		import { confirmEmailLink } from '../../scripts/auth-confirm';

		const root = document.querySelector<HTMLElement>('[data-auth-confirm]');
		if (root) void confirmEmailLink(root, useAuth(), window.location, window.history);
	</script>
</Layout>
