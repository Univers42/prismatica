---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Approve a Prismatica sign-in" description="Approve or refuse a sign-in to your Prismatica account." noindex>
	<main id="main-content" class="auth-page" data-auth-approve>
		<section class="auth-card" aria-labelledby="approve-title">
			<p class="eyebrow">Sign-in request</p>
			<h1 id="approve-title">Is this you signing in?</h1>
			<p data-approve-status role="status" aria-live="polite">Checking the sign-in request.</p>
			<dl data-approve-details hidden>
				<dt>Time</dt><dd data-approve-time></dd>
				<dt>Browser and system</dt><dd data-approve-browser></dd>
				<dt>Network address</dt><dd data-approve-address></dd>
				<dt>Place</dt><dd data-approve-place></dd>
			</dl>
			<form data-approve-form novalidate hidden>
				<div class="field">
					<label for="approve-number">Number shown on the screen you are signing in on</label>
					<input id="approve-number" data-approve-number name="number" type="text" inputmode="numeric" autocomplete="off" pattern="\d{2}" maxlength="2" placeholder="42" required />
				</div>
				<button class="button button--primary" type="submit">Approve</button>
				<button class="button button--ghost" type="button" data-approve-deny>It wasn't me</button>
			</form>
			<a class="text-link" href="/">Return home</a>
		</section>
	</main>
	<script>
		import { authConfig } from '../../lib/auth-config';
		import { gatewayPoster, mountApprovePage } from '../../scripts/auth-approve';

		const root = document.querySelector<HTMLElement>('[data-auth-approve]');
		if (root) {
			void mountApprovePage(root, { location: window.location, history: window.history, post: gatewayPoster(fetch, authConfig.gatewayUrl) }).catch(() => {
				const status = root.querySelector('[data-approve-status]');
				if (status) status.textContent = 'Could not reach the sign-in service. Nothing was approved.';
			});
		}
	</script>
</Layout>
