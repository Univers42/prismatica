---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Signing in · Prismatica" description="Completing your Prismatica sign-in." noindex referrerPolicy="no-referrer">
	<main id="main-content" class="auth-page" data-auth-callback>
		<section class="auth-card" aria-labelledby="callback-title">
			<p class="eyebrow">Sign in</p>
			<h1 id="callback-title">Completing your sign-in…</h1>
			<div class="auth-loading" data-auth-loading aria-hidden="true"><span></span><span></span><span></span></div>
			<p data-auth-status role="status" aria-live="polite">Opening your workspace.</p>
			<noscript><p>Signing in needs JavaScript. Turn it on and try again.</p></noscript>
			<a class="button button--primary" data-callback-home href="/" hidden>Go to homepage</a>
		</section>
	</main>
	<script>
		import { authConfig } from '../../lib/auth-config';
		import { completeOAuthCallback } from '../../scripts/auth-callback';

		const root = document.querySelector('[data-auth-callback]');
		const title = root?.querySelector('#callback-title');
		const status = root?.querySelector('[data-auth-status]');
		const loading = root?.querySelector('[data-auth-loading]');
		const home = root?.querySelector('[data-callback-home]');
		void completeOAuthCallback(authConfig.gatewayUrl, window.location, window.history, window.sessionStorage).then((outcome) => {
			if (outcome.kind === 'redirect') {
				window.location.assign(outcome.url);
				return;
			}
			if (title) title.textContent = 'Sign-in did not finish';
			if (loading instanceof HTMLElement) loading.hidden = true;
			if (home instanceof HTMLElement) home.hidden = false;
			if (status) {
				status.textContent = outcome.message;
				status.classList.add('is-error');
			}
		});
	</script>
</Layout>
