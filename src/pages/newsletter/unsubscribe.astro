---
import Layout from '../../layouts/Layout.astro';
import AuthResult from '../../components/ui/AuthResult.astro';
---

<Layout title="Unsubscribe from Prismatica" description="Unsubscribe from the Prismatica newsletter." noindex>
	<main id="main-content" class="auth-page" data-newsletter-unsubscribe>
		<AuthResult id="newsletter-unsubscribe" eyebrow="Newsletter" title="Unsubscribing you…" message="Removing your address from the newsletter. This takes a few seconds." />
	</main>
	<script>
		import { showAuthResult, type AuthResult } from '../../scripts/auth-result';
		import { postNewsletterToken, type NewsletterOutcome } from '../../scripts/newsletter-link';

		const USE_LATEST = 'Open the most recent newsletter you received and select its “One-click unsubscribe” link.';
		const RESULTS: Record<NewsletterOutcome, AuthResult> = {
			done: { tone: 'success', title: 'You are unsubscribed', message: 'You will not receive the Prismatica newsletter any more. Emails about your account, such as sign-in links, are not affected.', steps: [] },
			missing: { tone: 'notice', title: 'This unsubscribe link is incomplete', message: 'Part of the link is missing, so your address could not be identified. Nothing was changed.', steps: [USE_LATEST] },
			refused: { tone: 'notice', title: 'This unsubscribe link no longer works', message: 'It was already used or has expired. If it was already used, you are unsubscribed.', steps: [`Still receiving the newsletter? ${USE_LATEST}`] },
			unreachable: { tone: 'danger', title: 'The newsletter service did not answer', message: 'Your request could not be processed right now. Nothing was changed.', steps: ['Check your internet connection.', 'Open the unsubscribe link again in a minute.'] },
		};

		const card = document.querySelector<HTMLElement>('[data-newsletter-unsubscribe] [data-auth-result]');
		void postNewsletterToken(fetch, '/api/newsletter/unsubscribe', window.location.search).then((outcome) => {
			if (card) showAuthResult(card, RESULTS[outcome]);
		});
	</script>
</Layout>
