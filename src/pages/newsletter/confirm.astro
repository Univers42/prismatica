---
import Layout from '../../layouts/Layout.astro';
import AuthResult from '../../components/ui/AuthResult.astro';
---

<Layout title="Confirm newsletter subscription" description="Confirm your Prismatica newsletter double opt-in." noindex>
	<main id="main-content" class="auth-page" data-newsletter-confirm>
		<AuthResult id="newsletter-confirm" eyebrow="Newsletter" title="Confirming your subscription…" message="Checking the link from your email. This takes a few seconds." />
	</main>
	<script>
		import { showAuthResult, type AuthResult } from '../../scripts/auth-result';
		import { postNewsletterToken, type NewsletterOutcome } from '../../scripts/newsletter-link';

		const SUBSCRIBE_AGAIN = 'Subscribe again with the newsletter form at the bottom of the homepage, then open the new email.';
		const RESULTS: Record<NewsletterOutcome, AuthResult> = {
			done: { tone: 'success', title: 'You are subscribed', message: 'Thank you. The next Prismatica newsletter will reach your inbox. Every issue has a one-click unsubscribe link.', steps: [] },
			missing: { tone: 'notice', title: 'This confirmation link is incomplete', message: 'Part of the link is missing. Some mail apps cut long links.', steps: ['Open the confirmation email and select “Yes, subscribe me” again.', `Still not working? ${SUBSCRIBE_AGAIN}`] },
			refused: { tone: 'notice', title: 'This confirmation link no longer works', message: 'It has expired or was already used. You were not subscribed by this link.', steps: [SUBSCRIBE_AGAIN] },
			unreachable: { tone: 'danger', title: 'The newsletter service did not answer', message: 'Your subscription could not be confirmed right now.', steps: ['Check your internet connection.', 'Open the link from your email again in a minute.'] },
		};

		const card = document.querySelector<HTMLElement>('[data-newsletter-confirm] [data-auth-result]');
		void postNewsletterToken(fetch, '/api/newsletter/confirm', window.location.search).then((outcome) => {
			if (card) showAuthResult(card, RESULTS[outcome]);
		});
	</script>
</Layout>
