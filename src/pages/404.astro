---
import Layout from '../layouts/Layout.astro';
import HeaderNew from '../components/sections/HeaderNew.astro';
import FooterNew from '../components/sections/FooterNew.astro';
import Button from '../components/ui/Button.astro';
---

<Layout title="404: Not Found — Prismatica">
	<HeaderNew />
	<main id="main-content" class="section-shell not-found">
		<h1 class="not-found__code">404</h1>
		<p class="not-found__text">The page you're looking for doesn't exist, has been moved, or is temporarily unavailable.</p>
		<div class="not-found__action">
			<Button variant="primary" href="/">Return to Home</Button>
		</div>
	</main>
	<FooterNew />
</Layout>

<style>
	.not-found {
		min-height: 60vh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		gap: 1.5rem;
	}

	.not-found__code {
		font-size: 5rem;
		margin: 0;
		line-height: 1;
		color: var(--system-text-strong);
	}

	.not-found__text {
		font-size: 1.25rem;
		color: var(--system-text-muted);
		max-width: 40ch;
	}

	.not-found__action {
		margin-top: 1rem;
	}
</style>
