---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found | Prismatica" description="This page does not exist." noindex>
	<main id="main-content" class="page-main">
		<div class="container message-card">
			<p class="label">404</p>
			<h1>This page does not exist.</h1>
			<p>It may have moved, or the link may be mistyped. The home page has everything the site offers.</p>
			<a class="text-link" href="/">Go to the home page</a>
		</div>
	</main>
</Layout>
