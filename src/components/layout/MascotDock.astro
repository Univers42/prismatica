---
// Floating mascot dock — bottom-left, non-intrusive, never blocks content.
// The actual mascot SVG is injected by `src/scripts/main.ts` mountMascot()
// into the `#mascot-anchor` slot below. This component just provides the
// shell (positioning, glow, label). Hides on small screens so it doesn't
// fight with the mobile drawer / final CTA.
//
// Decisions:
// - Fixed bottom-left, not bottom-right, so it never overlaps the chat /
//   support widget pattern users expect on the right.
// - `aria-live` is OFF on the wrapper — the mascot is decorative chrome.
// - Includes a small "speech" bubble with a rotating tip; users can dismiss
//   it (collapses to just the mascot button).
// - Pointer-events are managed so the giant bubble doesn't block links
//   underneath when collapsed.
---

<aside class="mascot-dock" data-component="mascot-dock" aria-label="Prismatica assistant">
	<div class="mascot-dock__bubble" data-mascot-bubble>
		<button
			class="mascot-dock__bubble-close"
			type="button"
			aria-label="Hide assistant tip"
			data-mascot-dismiss
		>×</button>
		<p class="mascot-dock__tip" data-mascot-tip>Try it: open the page above and type /.</p>
	</div>
	<div id="mascot-anchor" class="mascot-dock__anchor"></div>
</aside>

<script>
	// Bundled (not is:inline) so it loads under a strict `script-src 'self'` CSP.
	import { MASCOT_LINES, ASSISTANT_PROMPT_LINE, STUDIO_STEP_EVENT } from '../../data/mascot-lines';
	import { observeReadingBand } from '../../lib/reading-band';
	import { setMountedMascotMood } from '../../scripts/mascot';

	(() => {
		const dock = document.querySelector<HTMLElement>('[data-component="mascot-dock"]');
		if (!dock) return;
		const bubble = dock.querySelector('[data-mascot-bubble]');
		const tipEl = dock.querySelector('[data-mascot-tip]');
		const dismiss = dock.querySelector('[data-mascot-dismiss]');
		const STORAGE_KEY = 'prismatica:mascot-tip-dismissed';
		let dismissed = (() => {
			try { return globalThis.localStorage?.getItem(STORAGE_KEY) === '1'; }
			catch { return false; }
		})();
		if (dismissed && bubble) bubble.setAttribute('hidden', '');
		dismiss?.addEventListener('click', () => {
			dismissed = true;
			bubble?.setAttribute('hidden', '');
			try { globalThis.localStorage?.setItem(STORAGE_KEY, '1'); } catch {}
		});

		// Speaks one line at a time: the tip is shown while `is-speaking` is on
		// the dock (CSS), and exactly one hide timer arms it back off. Speech is
		// driven by what is being read, not a fixed rotation timer.
		// Caveat: 5 s per section line and 7 s for the assistant prompt are
		// reading-pace guesses, not measured reading times.
		const SECTION_MS = 5000;
		const ASSISTANT_MS = 7000;
		let hideTimer = 0;
		const speak = (line: string, ms: number) => {
			// Never wake the dismissed bubble: the reader opted out.
			if (dismissed || !tipEl) return;
			window.clearTimeout(hideTimer);
			tipEl.textContent = line;
			dock.classList.add('is-speaking');
			hideTimer = window.setTimeout(() => dock.classList.remove('is-speaking'), ms);
		};

		// One line per page section: when the section in the reading band
		// changes, the dock says that section's line.
		const lineBySection = new Map<Element, string>();
		for (const { section, line } of MASCOT_LINES) {
			const el = document.getElementById(section);
			if (el) lineBySection.set(el, line);
		}
		if (lineBySection.size > 0) {
			observeReadingBand(lineBySection.keys(), (active) => {
				if (!active) return;
				speak(lineBySection.get(active) ?? '', SECTION_MS);
			});
		}
		// The studio story fires this when the reader reaches the assistant
		// step: speak the prompt and let the mascot think.
		document.addEventListener(STUDIO_STEP_EVENT, (event) => {
			if ((event as CustomEvent).detail !== 'assistant') return;
			speak(ASSISTANT_PROMPT_LINE, ASSISTANT_MS);
			setMountedMascotMood('thinking', 1400);
		});

		// On phones the dock covers body text while scrolling down, so it
		// tucks away; it returns on a scroll up (`.is-tucked` off) or once the
		// reader stops for a beat.
		// Caveat: the 1.2 s idle is a feel value, not a reading-time measure;
		// jumpy inertial scrolling can flap tuck/untuck near its threshold.
		const phone = window.matchMedia('(max-width: 640px)');
		const IDLE_MS = 1200;
		let lastY = window.scrollY;
		let idleTimer = 0;
		const untuck = () => dock.classList.remove('is-tucked');
		window.addEventListener('scroll', () => {
			const y = window.scrollY;
			const dy = y - lastY;
			lastY = y;
			if (!phone.matches) return;
			if (dy > 2) dock.classList.add('is-tucked');
			else if (dy < -2) untuck();
			window.clearTimeout(idleTimer);
			idleTimer = window.setTimeout(untuck, IDLE_MS);
		}, { passive: true });

		// Quiet while the hero fills the screen: the bubble sat on the hero's copy.
		const hero = document.getElementById('top');
		if (hero && typeof IntersectionObserver !== 'undefined') {
			new IntersectionObserver(([entry]) => {
				dock.classList.toggle('is-quiet', (entry?.intersectionRatio ?? 0) >= 0.5);
			}, { threshold: [0, 0.5, 1] }).observe(hero);
		}
	})();
</script>

<style is:global>
	.mascot-dock {
		position: fixed;
		left: clamp(0.75rem, 2vw, 1.5rem);
		bottom: clamp(0.75rem, 2vw, 1.5rem);
		/* Above swipe-stack__tail (footer, z-index: 9999) so the mascot never
		   disappears behind the footer. Stays below the native <dialog> portal,
		   which lives in the top-layer and is unaffected by z-index. */
		z-index: 10000;
		display: grid;
		gap: 0.6rem;
		justify-items: start;
		pointer-events: none;
	}

	/* When the portal dialog is open, hide the mascot to avoid double-CTA noise. */
	body.dialog-open .mascot-dock { display: none; }

	/* Same for the consent bar: on phones the mascot sat on top of "Accept all". */
	body:has(.consent-banner:not([hidden])) .mascot-dock { display: none; }

	.mascot-dock__bubble {
		position: relative;
		max-width: 240px;
		padding: 0.7rem 0.9rem 0.7rem 0.9rem;
		background: var(--system-surface);
		border: 1px solid var(--system-border);
		border-radius: var(--system-radius-lg);
		box-shadow: var(--system-shadow-2);
		font-family: var(--system-font-sans);
		font-size: 0.86rem;
		line-height: 1.4;
		color: var(--system-text);
		pointer-events: auto;
		opacity: 0;
		translate: 0 8px;
		scale: 0.94;
		transform-origin: 22px 100%;
		visibility: hidden;
		transition:
			opacity 220ms linear,
			translate 360ms var(--ease-premium),
			scale 360ms var(--ease-premium),
			visibility 0s linear 360ms;
	}

	.mascot-dock__bubble[hidden] { display: none; }

	/* Phone tuck: while the reader scrolls down the dock slides out of the
	   way; `.is-tucked` is toggled by the script. Reduced motion: it simply
	   hides/shows, no slide. */
	.mascot-dock.is-tucked {
		translate: 0 140%;
		opacity: 0;
		visibility: hidden;
	}

	@media (prefers-reduced-motion: no-preference) {
		.mascot-dock {
			transition:
				translate 260ms var(--ease-premium),
				opacity 200ms linear,
				visibility 0s linear 260ms;
		}
		/* Showing again: no visibility delay, or the dock would pop invisible. */
		.mascot-dock:not(.is-tucked) {
			transition: translate 260ms var(--ease-premium), opacity 160ms linear, visibility 0s;
		}
	}

	/* Out of the way while the hero fills the screen (.is-quiet). */
	.mascot-dock:is(.is-speaking, :hover, :focus-within):not(.is-quiet) .mascot-dock__bubble {
		opacity: 1;
		translate: none;
		scale: none;
		visibility: visible;
		transition-delay: 0s;
	}

	/* On phones the bubble covered body text at every scroll position. */
	@media (max-width: 640px) {
		.mascot-dock {
			transform: scale(0.7);
			transform-origin: left bottom;
		}
		.mascot-dock__bubble { display: none; }
	}

	.mascot-dock__bubble::after {
		content: '';
		position: absolute;
		left: 22px;
		bottom: -7px;
		width: 14px;
		height: 14px;
		background: inherit;
		border-right: 1px solid var(--system-border);
		border-bottom: 1px solid var(--system-border);
		transform: rotate(45deg);
	}

	.mascot-dock__bubble-close {
		position: absolute;
		top: 4px;
		right: 6px;
		width: 22px;
		height: 22px;
		display: grid;
		place-items: center;
		background: transparent;
		border: 0;
		border-radius: 50%;
		color: var(--system-text-muted);
		font-size: 1.05rem;
		line-height: 1;
		cursor: pointer;
	}
	.mascot-dock__bubble-close:hover { background: var(--system-action-secondary-bg-hover); color: var(--system-text-strong); }
	.mascot-dock__bubble-close:focus-visible {
		outline: 3px solid var(--system-focus-ring);
		outline-offset: 2px;
	}

	.mascot-dock__tip { margin: 0; padding-right: 1rem; }

	.mascot-dock__anchor {
		position: relative;
		width: 76px;
		height: 56px;
		pointer-events: auto;
		filter: drop-shadow(0 6px 14px color-mix(in srgb, var(--brand-canvas-bg) 18%, transparent));
		transition: transform 220ms var(--system-ease-emphasized);
	}
	.mascot-dock__anchor:hover { transform: translateY(-3px) scale(1.04); }

	.mascot-dock__anchor .binocle {
		display: block;
		width: 100%;
		height: 100%;
		padding: 0;
		background: transparent;
		border: 0;
		cursor: pointer;
	}

	@media (max-width: 540px) {
		.mascot-dock__bubble { display: none; }
		.mascot-dock__anchor { width: 64px; height: 48px; }
	}

	@media (prefers-reduced-motion: reduce) {
		.mascot-dock,
		.mascot-dock__bubble,
		.mascot-dock__anchor { animation: none; transition: none; }
	}
</style>
