---
interface Props {
	id?: string;
}

const { id = 'newsletter-signup' } = Astro.props;
---

<form class="newsletter-signup" data-newsletter-signup novalidate aria-labelledby={`${id}-title`}>
	<h2 class="label" id={`${id}-title`}>Newsletter</h2>
	<p>A short note when something ships, and one link to leave.</p>
	<div class="field">
		<label for={`${id}-email`}>Email address</label>
		<input id={`${id}-email`} name="email" type="email" autocomplete="email" required />
	</div>
	<label class="consent-toggle" for={`${id}-consent`}>
		<input id={`${id}-consent`} name="newsletter_consent" type="checkbox" required />
		<span>I agree to receive the Prismatica newsletter and can unsubscribe at any time (<a href="/legal/privacy-policy/">Privacy Policy</a>).</span>
	</label>
	<button class="button button--ghost" type="submit">Subscribe</button>
	<output class="form-status" aria-live="polite" data-newsletter-status></output>
</form>
