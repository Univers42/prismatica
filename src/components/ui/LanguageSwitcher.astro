---
import { SUPPORTED_LOCALES, DEFAULT_LOCALE, type SupportedLocale, t } from '../../lib/i18n';
import { normalizeLocale } from '../../lib/locale';

export type Props = {
	readonly currentLocale?: string;
	readonly class?: string;
	readonly isDrawer?: boolean;
};

const { currentLocale = DEFAULT_LOCALE, class: className = '', isDrawer = false } = Astro.props;

const activeLocale = normalizeLocale(currentLocale, {
	defaultLocale: DEFAULT_LOCALE,
	supportedLocales: SUPPORTED_LOCALES,
}) as SupportedLocale;

export const LOCALE_LABELS: Record<SupportedLocale, { nativeName: string; code: string }> = {
	en: { nativeName: 'English', code: 'EN' },
	es: { nativeName: 'Español', code: 'ES' },
	ar: { nativeName: 'العربية', code: 'AR' },
};

const currentIndex = SUPPORTED_LOCALES.indexOf(activeLocale);
const nextIndex = (currentIndex + 1) % SUPPORTED_LOCALES.length;
const nextLocale = SUPPORTED_LOCALES[nextIndex] ?? DEFAULT_LOCALE;

const currentLabel = LOCALE_LABELS[activeLocale];
const nextLabel = LOCALE_LABELS[nextLocale];
const ariaLabel = t(activeLocale, 'site.language.label', { code: currentLabel.code, current: currentLabel.nativeName, next: nextLabel.nativeName });
const title = t(activeLocale, 'site.language.title', { next: nextLabel.nativeName });
const languageName = t(activeLocale, 'site.language.current', { current: currentLabel.nativeName });
---

<a
	href={`?lang=${nextLocale}`}
	class:list={[
		'header-new__theme',
		'lang-switcher',
		isDrawer && 'header-new__theme--drawer lang-switcher--drawer',
		className,
	]}
	aria-label={ariaLabel}
	title={title}
	data-current-lang={activeLocale}
	data-next-lang={nextLocale}
	data-js-only
>
	<svg class="header-icon--lang" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
		<circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.6" />
		<path d="M3.6 9h16.8M3.6 15h16.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
		<ellipse cx="12" cy="12" rx="4.5" ry="9" fill="none" stroke="currentColor" stroke-width="1.6" />
	</svg>
	{isDrawer ? (
		<span data-lang-label>{languageName}</span>
	) : (
		<span class="header-icon__lang-badge" aria-hidden="true">{currentLabel.code}</span>
		<span class="visually-hidden" data-lang-label>{languageName}</span>
	)}
</a>

<style is:global>
	.lang-switcher {
		text-decoration: none;
		position: relative;
		display: inline-grid;
		place-items: center;
	}

	.header-icon--lang {
		width: 20px;
		height: 20px;
	}

	.header-icon__lang-badge {
		position: absolute;
		inset-inline-end: 2px;
		bottom: 2px;
		font-family: var(--font-mono);
		font-size: 0.58rem;
		font-weight: 700;
		line-height: 1;
		padding: 1px 2px;
		border-radius: 2px;
		background: color-mix(in srgb, var(--signal) 25%, var(--raised));
		color: var(--ink);
		pointer-events: none;
	}

	.lang-switcher--drawer {
		display: inline-flex;
		justify-content: center;
		gap: 0.5rem;
		width: 100%;
	}
</style>