---
// Section 4: one dataset, four views. With JavaScript, a real tablist (arrow keys, Home, End)
// swaps the capture through a View Transition (motion M4). Without it, all four captures stack,
// each under its own heading, and the tablist is absent (data-js-only). The pre-paint script sets
// html[data-js] before first paint, so the panels never stack and then collapse.
import CaptureFrame from './CaptureFrame.astro';
import SavedView from './SavedView.astro';
import type { ShotId } from '../../data/shots';
import { DEFAULT_LOCALE, t } from '../../lib/i18n';

interface Props {
	locale?: string;
}

const { locale = DEFAULT_LOCALE } = Astro.props;

const views: { key: string; shot: ShotId }[] = [
	{ key: 'table', shot: 'S5' },
	{ key: 'board', shot: 'S4' },
	{ key: 'calendar', shot: 'S6' },
	{ key: 'chart', shot: 'S7' },
];
---

<section class="section" id="views" aria-labelledby="views-title">
	<div class="container container--wide">
		<div class="section__head views__head">
			<h2 id="views-title" data-i18n="site.views.title">{t(locale, 'site.views.title')}</h2>
			<p class="lead" data-i18n="site.views.lead">{t(locale, 'site.views.lead')}</p>
		</div>

		<SavedView locale={locale} />

		<div class="views" data-views>
			<div class="views__tabs" role="tablist" aria-label={t(locale, 'site.views.tabs')} data-i18n-aria-label="site.views.tabs" data-js-only>
				{views.map((view, i) => (
					<button
						class="views__tab"
						type="button"
						role="tab"
						id={`view-tab-${view.key}`}
						aria-controls={`view-panel-${view.key}`}
						aria-selected={i === 0 ? 'true' : 'false'}
						tabindex={i === 0 ? 0 : -1}
						data-i18n={`site.views.${view.key}`}
					>
						{t(locale, `site.views.${view.key}`)}
					</button>
				))}
			</div>

			{views.map((view, i) => (
				<div class="views__panel" id={`view-panel-${view.key}`} data-view-panel data-active={i === 0 ? '' : undefined}>
					<h3 class="views__panel-title" data-i18n={`site.views.${view.key}`}>{t(locale, `site.views.${view.key}`)}</h3>
					<CaptureFrame shot={view.shot} locale={locale} />
					<p class="views__note label" data-i18n={`site.views.${view.key}Note`}>{t(locale, `site.views.${view.key}Note`)}</p>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.views__head {
		text-align: center;
		justify-items: center;
	}

	.views {
		margin-top: var(--space-7);
		display: grid;
		gap: var(--space-6);
	}

	.views__tabs {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--space-2);
	}

	.views__tab {
		min-height: var(--control-h);
		padding: 0 var(--space-5);
		border: 1px solid var(--graphite);
		border-radius: var(--radius-pill);
		background: transparent;
		color: var(--ink);
		font-weight: 600;
	}

	.views__tab[aria-selected='true'] {
		background: var(--ink);
		border-color: var(--ink);
		color: var(--paper);
	}

	.views__panel {
		display: grid;
		gap: var(--space-3);
	}

	.views__note {
		text-align: center;
		max-width: none;
	}

	:global(html[data-js]) .views__panel-title {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}

	:global(html[data-js]) .views__panel:not([data-active]) {
		display: none;
	}

	.views__panel :global(.frame) {
		view-transition-name: views-capture;
	}
</style>
