---
// The one header. Its filled-looking control is a ghost button, so the hero's tour button stays the
// only primary action in the first viewport (PLAN §2.4). Below 48rem the nav folds into a
// <details> menu, which opens and closes with no script, and the language switcher moves into it:
// four controls and the name do not fit a 390px bar. Controls that need JavaScript (theme, sign-in)
// carry data-js-only and are absent until the pre-paint script marks <html data-js>.
import favicon from '../../assets/brand/favicon.svg';
import { NAV } from '../../data/links';
import LanguageSwitcher from '../ui/LanguageSwitcher.astro';
import { DEFAULT_LOCALE, t } from '../../lib/i18n';

interface Props {
	locale?: string;
}

const { locale = DEFAULT_LOCALE } = Astro.props;

const themeLabel = t(locale, 'site.theme.label', { current: t(locale, 'site.theme.system'), next: t(locale, 'site.theme.light') });
---

<header class="site-header">
	<div class="container container--wide site-header__bar">
		<a class="site-header__brand" href="/">
			<img src={favicon.src} alt="" width="24" height="24" />
			<span>Prismatica</span>
		</a>

		<nav class="site-header__nav" aria-label={t(locale, 'site.nav.main')} data-i18n-aria-label="site.nav.main">
			<ul>
				{NAV.map((item) => <li><a href={item.href} data-i18n={item.key}>{t(locale, item.key)}</a></li>)}
			</ul>
		</nav>

		<div class="site-header__actions">
			<button class="button button--icon" type="button" data-theme-toggle data-js-only aria-label={themeLabel}>
				<svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false">
					<circle cx="10" cy="10" r="7" fill="none" stroke="currentColor" stroke-width="1.6" />
					<path d="M10 3a7 7 0 0 1 0 14z" fill="currentColor" />
				</svg>
			</button>
			<LanguageSwitcher class="button button--icon site-header__language" currentLocale={locale} />
			<button class="site-header__signin" type="button" data-open-connect data-js-only data-i18n="auth.signIn">{t(locale, 'auth.signIn')}</button>
			<button class="button button--ghost site-header__create" type="button" data-open-portal data-js-only data-i18n="site.nav.createWorkspace">{t(locale, 'site.nav.createWorkspace')}</button>
			<details class="site-menu">
				<summary class="button button--icon" aria-label={t(locale, 'site.nav.menu')} data-i18n-aria-label="site.nav.menu">
					<svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false">
						<path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
					</svg>
				</summary>
				<nav class="site-menu__panel" aria-label={t(locale, 'site.nav.main')} data-i18n-aria-label="site.nav.main">
					<ul>
						{NAV.map((item) => <li><a href={item.href} data-i18n={item.key}>{t(locale, item.key)}</a></li>)}
						<li data-js-only><LanguageSwitcher class="site-menu__language" currentLocale={locale} isDrawer /></li>
						<li data-js-only><button class="text-link" type="button" data-open-portal data-i18n="site.nav.createWorkspace">{t(locale, 'site.nav.createWorkspace')}</button></li>
					</ul>
				</nav>
			</details>
		</div>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: var(--z-header);
		background: var(--paper);
		border-bottom: 1px solid var(--rule);
	}

	.site-header__bar {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		min-height: 4rem;
	}

	.site-header__brand {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		font-weight: 600;
		text-decoration: none;
	}

	.site-header__nav {
		display: none;
	}

	.site-header__nav ul,
	.site-menu__panel ul {
		list-style: none;
		padding: 0;
		display: flex;
		gap: var(--space-5);
	}

	.site-header__nav a,
	.site-menu__panel a {
		text-decoration: none;
		color: var(--graphite);
	}

	.site-header__nav a:hover,
	.site-menu__panel a:hover {
		color: var(--ink);
	}

	.site-header__actions {
		margin-inline-start: auto;
		display: flex;
		align-items: center;
		gap: var(--space-3);
	}

	.site-header__signin {
		background: none;
		border: 0;
		padding: var(--space-2);
		font-weight: 600;
		white-space: nowrap;
	}

	.site-header__actions :global(.site-header__language) {
		display: none;
	}

	.site-menu__panel :global(.site-menu__language) {
		justify-content: flex-start;
		color: var(--graphite);
	}

	.site-header__create {
		display: none;
	}

	.site-menu {
		position: relative;
	}

	.site-menu summary {
		list-style: none;
	}

	.site-menu summary::-webkit-details-marker {
		display: none;
	}

	.site-menu__panel {
		position: absolute;
		inset-inline-end: 0;
		top: calc(100% + var(--space-2));
		min-width: 14rem;
		padding: var(--space-4);
		background: var(--raised);
		border: 1px solid var(--rule);
		border-radius: var(--radius-m);
		box-shadow: var(--shadow-2);
	}

	.site-menu__panel ul {
		flex-direction: column;
		gap: var(--space-3);
	}

	@media (min-width: 48rem) {
		.site-header__bar {
			gap: var(--space-6);
		}

		.site-header__nav {
			display: block;
		}

		.site-header__actions :global(.site-header__language) {
			display: inline-grid;
		}

		.site-header__create {
			display: inline-flex;
		}

		.site-menu {
			display: none;
		}
	}
</style>
