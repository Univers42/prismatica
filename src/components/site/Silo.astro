---
// Section 2: the problem, drawn (V2). Four departments each keep their own card for the same
// customer, and the copies disagree; below them sits the one record they become. Built as HTML
// rather than SVG so the text scales, themes and reads aloud like the rest of the page.
// The slide-together motion (M2) is scroll-linked where animation-timeline exists and motion is
// welcome; everywhere else this is the finished drawing. Nothing starts hidden: off-screen content
// at its "before" frame is still fully visible (the old site's blank-below-the-fold defect).
import { department } from '../../data/departments';
import { DEFAULT_LOCALE, t } from '../../lib/i18n';

interface Props {
	locale?: string;
}

const { locale = DEFAULT_LOCALE } = Astro.props;

const copies = [
	{ ...department('Sales'), labelKey: 'site.silo.sales', name: 'Marc Delorme', detailKey: 'site.silo.salesDetail' },
	{ ...department('Finance'), labelKey: 'site.silo.finance', name: 'M. Delorme', detailKey: 'site.silo.financeDetail' },
	{ ...department('Operations'), labelKey: 'site.silo.operations', name: 'Delorme, Marc', detailKey: 'site.silo.operationsDetail' },
	{ ...department('Learning'), labelKey: 'site.silo.notes', name: 'Marc (Varenne)', detailKey: 'site.silo.notesDetail' },
];
---

<section class="section" aria-labelledby="silo-title">
	<div class="container">
		<div class="section__head">
			<h2 id="silo-title" data-i18n="site.silo.title">{t(locale, 'site.silo.title')}</h2>
			<p class="lead" data-i18n="site.silo.lead">{t(locale, 'site.silo.lead')}</p>
		</div>

		<figure class="silo">
			<ul class="silo__copies">
				{copies.map((copy) => (
					<li class="silo__card">
						<svg class="silo__bar" viewBox="0 0 100 3" preserveAspectRatio="none" aria-hidden="true" focusable="false"><rect width="100" height="3" fill={copy.hue} /></svg>
						<span class="label" data-i18n={copy.labelKey}>{t(locale, copy.labelKey)}</span>
						<span class="silo__name">{copy.name}</span>
						<span class="silo__detail" data-i18n={copy.detailKey}>{t(locale, copy.detailKey)}</span>
					</li>
				))}
			</ul>
			<div class="silo__record">
				<span class="label" data-i18n="site.silo.record">{t(locale, 'site.silo.record')}</span>
				<span class="silo__name">Marc Delorme</span>
				<span class="silo__detail" data-i18n="site.silo.recordDetail">{t(locale, 'site.silo.recordDetail')}</span>
			</div>
			<figcaption class="visually-hidden" data-i18n="site.silo.caption">{t(locale, 'site.silo.caption')}</figcaption>
		</figure>
	</div>
</section>

<style>
	.silo {
		margin: 0;
		display: grid;
		gap: var(--space-6);
		justify-items: center;
	}

	.silo__copies {
		list-style: none;
		padding: 0;
		width: 100%;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 9.5rem), 1fr));
		gap: var(--space-4);
	}

	.silo__card,
	.silo__record {
		display: grid;
		gap: var(--space-1);
		max-width: none;
		padding: var(--space-4);
		background: var(--raised);
		border: 1px solid var(--rule);
		border-radius: var(--radius-m);
	}

	.silo__card {
		position: relative;
		overflow: hidden;
	}

	.silo__bar {
		position: absolute;
		inset: 0 0 auto;
		width: 100%;
		height: 3px;
	}

	.silo__record {
		width: min(100%, 30rem);
		border: 1px solid var(--ink);
		border-top: 3px solid var(--signal);
		box-shadow: var(--shadow-1);
	}

	.silo__name {
		font-weight: 600;
	}

	.silo__detail {
		color: var(--graphite);
		font-size: var(--step--1);
	}

	@media (prefers-reduced-motion: no-preference) {
		@supports (animation-timeline: view()) {
			.silo__card {
				animation: silo-gather linear both;
				animation-timeline: view();
				animation-range: entry 20% cover 55%;
			}

			.silo__record {
				animation: silo-arrive linear both;
				animation-timeline: view();
				animation-range: entry 20% cover 55%;
			}
		}
	}

	@keyframes silo-gather {
		to {
			transform: translateY(var(--space-5)) scale(0.92);
		}
	}

	@keyframes silo-arrive {
		from {
			transform: translateY(calc(-1 * var(--space-6))) scale(0.94);
		}
	}
</style>
