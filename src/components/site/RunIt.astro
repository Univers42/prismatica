---
// Section 6: where it runs, promising only what ships (PLAN §9 Q1, D-031): the hosted workspace
// on grobase, and the one desktop release that exists, with the Docker backend it still needs.
import { RELEASE, SOURCE_URL } from '../../data/links';
import { DEFAULT_LOCALE, t } from '../../lib/i18n';

interface Props {
	locale?: string;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
---

<section class="section" id="run" aria-labelledby="run-title">
	<div class="container">
		<div class="section__head">
			<h2 id="run-title" data-i18n="site.run.title">{t(locale, 'site.run.title')}</h2>
			<p class="lead" data-i18n="site.run.lead">{t(locale, 'site.run.lead')}</p>
		</div>

		<div class="run">
			<article class="run__option" aria-labelledby="run-team">
				<h3 id="run-team" data-i18n="site.run.teamTitle">{t(locale, 'site.run.teamTitle')}</h3>
				<p data-i18n="site.run.teamBody">{t(locale, 'site.run.teamBody')}</p>
				<ul class="run__facts">
					<li data-i18n="site.run.teamSignIn">{t(locale, 'site.run.teamSignIn')}</li>
					<li data-i18n="site.run.teamDatabases">{t(locale, 'site.run.teamDatabases')}</li>
				</ul>
				<button class="text-link" type="button" data-open-portal data-js-only data-i18n="site.hero.create">{t(locale, 'site.hero.create')}</button>
			</article>

			<article class="run__option" aria-labelledby="run-local">
				<h3 id="run-local" data-i18n="site.run.localTitle">{t(locale, 'site.run.localTitle')}</h3>
				<p data-i18n="site.run.localBody">{t(locale, 'site.run.localBody', { engine: RELEASE.engine })}</p>
				<ul class="run__facts">
					<li data-i18n="site.run.platforms">{t(locale, 'site.run.platforms')}</li>
					<li><span data-i18n="site.run.backendBefore">{t(locale, 'site.run.backendBefore', { backend: RELEASE.backend })}</span> <a href={SOURCE_URL} rel="noopener" data-i18n="site.run.backendLink">{t(locale, 'site.run.backendLink')}</a></li>
					<li><span data-i18n="site.run.release">{t(locale, 'site.run.release')}</span> <code>{RELEASE.tag}</code></li>
				</ul>
				<a class="text-link" href={RELEASE.url} rel="noopener" data-i18n="site.run.download">{t(locale, 'site.run.download')}</a>
			</article>
		</div>
	</div>
</section>

<style>
	.run {
		display: grid;
		gap: var(--space-5);
	}

	.run__option {
		display: grid;
		gap: var(--space-4);
		align-content: start;
		padding: var(--space-6);
		background: var(--raised);
		border: 1px solid var(--rule);
		border-radius: var(--radius-l);
	}

	.run__option > p {
		color: var(--graphite);
	}

	.run__facts {
		padding-inline-start: var(--space-5);
		display: grid;
		gap: var(--space-2);
	}

	.run__note {
		font-size: var(--step--1);
	}

	@media (min-width: 48rem) {
		.run {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
