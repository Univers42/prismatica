---
// Section 8: click 2 again, for whoever read to the end.
import { DEFAULT_LOCALE, t } from '../../lib/i18n';

interface Props {
	locale?: string;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
---

<section class="section final" aria-labelledby="final-title">
	<div class="container final__inner">
		<h2 id="final-title" data-i18n="site.final.title">{t(locale, 'site.final.title')}</h2>
		<p class="lead" data-i18n="site.final.lead">{t(locale, 'site.final.lead')}</p>
		<div class="final__actions">
			<button class="button button--primary" type="button" data-open-portal data-js-only data-i18n="site.final.create">{t(locale, 'site.final.create')}</button>
			<a class="text-link" href="/tour/" data-open-tour data-i18n="site.final.tour">{t(locale, 'site.final.tour')}</a>
		</div>
	</div>
</section>

<style>
	.final__inner {
		display: grid;
		gap: var(--space-4);
		justify-items: center;
		text-align: center;
	}

	.final__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: var(--space-3) var(--space-6);
		margin-top: var(--space-3);
	}
</style>
