---
// Section 7: what exists and what does not, in the product's own terms. It replaces the old FAQ,
// testimonials and logo strip, whose claims nothing backed (AUDIT R8). Each "not yet" is a known
// gap with evidence in groot docs/redesign/PLAN.md §5.1; remove a line only when its fix ships.
import { SOURCE_URL } from '../../data/links';
import { DEFAULT_LOCALE, t } from '../../lib/i18n';

interface Props {
	locale?: string;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
---

<section class="section" id="plainly" aria-labelledby="plainly-title">
	<div class="container">
		<div class="section__head">
			<h2 id="plainly-title" data-i18n="site.plainly.title">{t(locale, 'site.plainly.title')}</h2>
		</div>

		<div class="plainly">
			<div>
				<h3 data-i18n="site.plainly.does">{t(locale, 'site.plainly.does')}</h3>
				<ul>
					<li data-i18n="site.plainly.does1">{t(locale, 'site.plainly.does1')}</li>
					<li data-i18n="site.plainly.does2">{t(locale, 'site.plainly.does2')}</li>
					<li data-i18n="site.plainly.does3">{t(locale, 'site.plainly.does3')}</li>
					<li><span data-i18n="site.plainly.sourceBefore">{t(locale, 'site.plainly.sourceBefore')}</span> <a href={SOURCE_URL} rel="noopener">GitHub</a><span data-i18n="site.plainly.sourceAfter">{t(locale, 'site.plainly.sourceAfter')}</span></li>
				</ul>
			</div>
			<div>
				<h3 data-i18n="site.plainly.notDone">{t(locale, 'site.plainly.notDone')}</h3>
				<ul>
					<li data-i18n="site.plainly.not1">{t(locale, 'site.plainly.not1')}</li>
					<li data-i18n="site.plainly.not2">{t(locale, 'site.plainly.not2')}</li>
					<li data-i18n="site.plainly.not3">{t(locale, 'site.plainly.not3')}</li>
					<li data-i18n="site.plainly.not4">{t(locale, 'site.plainly.not4')}</li>
				</ul>
			</div>
		</div>
	</div>
</section>

<style>
	.plainly {
		display: grid;
		gap: var(--space-7);
	}

	.plainly h3 {
		margin-bottom: var(--space-4);
	}

	.plainly ul {
		padding-inline-start: var(--space-5);
		display: grid;
		gap: var(--space-3);
	}

	@media (min-width: 48rem) {
		.plainly {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
