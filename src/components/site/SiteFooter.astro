---
// The one footer: where to go next, the legal pages, who answers for the data, and the newsletter.
// The newsletter's script loads on first focus inside the form (main.ts), so the form costs no
// JavaScript on a visit that never touches it.
import NewsletterSignup from '../gdpr/NewsletterSignup.astro';
import { DATA_CONTROLLER, LEGAL_LINKS } from '../../data/legal';
import { LINKEDIN_URL, NAV, ORGANIZATION_URL, RELEASE, SOURCE_URL } from '../../data/links';
import { DEFAULT_LOCALE, t } from '../../lib/i18n';

interface Props {
	locale?: string;
}

const { locale = DEFAULT_LOCALE } = Astro.props;

// Typed by the hrefs in legal.ts, so a new legal page cannot reach the footer without a label.
const LEGAL_LABEL_KEYS: Record<(typeof LEGAL_LINKS)[number]['href'], string> = {
	'/legal/privacy-policy/': 'site.footer.privacy',
	'/legal/terms/': 'site.footer.terms',
	'/legal/cookies/': 'site.footer.cookies',
	'/legal/data-rights/': 'site.footer.dataRights',
};

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container container--wide site-footer__grid">
		<div class="site-footer__about">
			<p class="site-footer__name">Prismatica</p>
			<p data-i18n="site.footer.about">{t(locale, 'site.footer.about')}</p>
		</div>

		<nav aria-labelledby="footer-product">
			<h2 id="footer-product" class="label" data-i18n="footer.groupProduct">{t(locale, 'footer.groupProduct')}</h2>
			<ul>
				{NAV.map((item) => <li><a href={item.href} data-i18n={item.key}>{t(locale, item.key)}</a></li>)}
				<li><a href="/tour/" data-i18n="site.footer.tour">{t(locale, 'site.footer.tour')}</a></li>
				<li><a href={RELEASE.url} rel="noopener" data-i18n="site.footer.release">{t(locale, 'site.footer.release')}</a></li>
				<li><a href={SOURCE_URL} rel="noopener" data-i18n="site.footer.source">{t(locale, 'site.footer.source')}</a></li>
			</ul>
		</nav>

		<nav aria-labelledby="footer-legal">
			<h2 id="footer-legal" class="label" data-i18n="footer.groupLegal">{t(locale, 'footer.groupLegal')}</h2>
			<ul>
				{LEGAL_LINKS.map((link) => <li><a href={link.href} data-i18n={LEGAL_LABEL_KEYS[link.href]}>{t(locale, LEGAL_LABEL_KEYS[link.href])}</a></li>)}
				<li data-js-only><button class="text-link site-footer__cookies" type="button" data-manage-cookies data-i18n="footer.cookieSettings">{t(locale, 'footer.cookieSettings')}</button></li>
			</ul>
		</nav>

		<div class="site-footer__newsletter">
			<NewsletterSignup id="footer-newsletter" locale={locale} />
		</div>
	</div>
	<div class="container container--wide site-footer__base">
		<p class="label">© {year} Prismatica</p>
		<p class="label"><span data-i18n="site.footer.controller">{t(locale, 'site.footer.controller')}</span> <span data-i18n="site.footer.controllerName">{t(locale, 'site.footer.controllerName')}</span> · <a href={`mailto:${DATA_CONTROLLER.email}`}>{DATA_CONTROLLER.email}</a></p>
		<ul class="site-footer__social">
			<li><a href={ORGANIZATION_URL} rel="noopener noreferrer">GitHub</a></li>
			<li><a href={LINKEDIN_URL} rel="noopener noreferrer">LinkedIn</a></li>
		</ul>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: var(--space-9);
		padding-block: var(--space-8) var(--space-6);
		border-top: 1px solid var(--rule);
		background: var(--tint);
	}

	.site-footer__grid {
		display: grid;
		gap: var(--space-7);
	}

	.site-footer__name {
		font-family: var(--font-display);
		font-size: var(--step-2);
		line-height: 1.1;
		margin-bottom: var(--space-2);
	}

	.site-footer__about p:last-child {
		color: var(--graphite);
	}

	.site-footer ul {
		list-style: none;
		padding: 0;
		display: grid;
		gap: var(--space-2);
		margin-top: var(--space-3);
	}

	.site-footer nav a {
		text-decoration: none;
	}

	.site-footer nav a:hover {
		text-decoration: underline;
	}

	.site-footer__base {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-6);
		margin-top: var(--space-7);
		padding-top: var(--space-4);
		border-top: 1px solid var(--rule);
	}

	.site-footer ul.site-footer__social {
		display: flex;
		gap: var(--space-5);
		margin: 0;
	}

	@media (min-width: 48rem) {
		.site-footer__grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		.site-footer__newsletter {
			grid-column: 1 / -1;
		}
	}

	@media (min-width: 64rem) {
		.site-footer__grid {
			grid-template-columns: 1.4fr 1fr 1fr 1.6fr;
		}

		.site-footer__newsletter {
			grid-column: auto;
		}
	}
</style>
