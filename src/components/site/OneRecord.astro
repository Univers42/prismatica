---
// Section 3: the fix for section 2. The contact page shows one customer with every department's
// part of him linked, and the company page shows the many-to-many with roles.
import StorySection from './StorySection.astro';
import { DEFAULT_LOCALE, t } from '../../lib/i18n';

interface Props {
	locale?: string;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
---

<StorySection id="product" titleKey="site.oneRecord.title" shot="S2" secondShot="S3" locale={locale}>
	<p class="lead" data-i18n="site.oneRecord.lead">{t(locale, 'site.oneRecord.lead')}</p>
	<p data-i18n="site.oneRecord.body">{t(locale, 'site.oneRecord.body')}</p>
</StorySection>
