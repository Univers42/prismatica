---
// Section 3: the fix for section 2. The contact page shows one customer with every department's
// part of him linked, and the company page shows the many-to-many with roles.
import StorySection from './StorySection.astro';
---

<StorySection id="product" title="One record every department reads." shot="S2" secondShot="S3">
	<p class="lead">Sales sees the deal. Finance sees the invoice. Operations sees the order. It is the same record, so nobody types it twice.</p>
	<p>A contact links to their company, with the role they hold there, to every deal and invoice, and to the notes taken on each call. Open any of them and the others are one click away.</p>
</StorySection>
