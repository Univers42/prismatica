---
// Section 5: the second-brain half of the product, told through the operations story. Notes are
// pages, so they get backlinks and a place in the graph next to the records they informed.
import StorySection from './StorySection.astro';
import { DEFAULT_LOCALE, t } from '../../lib/i18n';

interface Props {
	locale?: string;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
---

<StorySection id="learning" titleKey="site.learning.title" shot="S8" secondShot="S9" reverse locale={locale}>
	<p class="lead" data-i18n="site.learning.lead">{t(locale, 'site.learning.lead')}</p>
	<p data-i18n="site.learning.body">{t(locale, 'site.learning.body')}</p>
</StorySection>
