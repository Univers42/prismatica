---
// Section 4's drawing (V4): six deals filter into a saved view, open deals over €5,000, largest
// first. The deals are the demo dataset's own (groot scripts/demo, seed 42). HTML, like V2, so
// the text scales, themes and reads aloud. The finished drawing is the default: the cards that
// do not match are dimmed and the view is filled. With motion welcome and JavaScript on,
// scripts/saved-view.ts plays the filter once when half of it is on screen (PLAN §6.2); nothing
// is ever hidden, the before frame only dims the view.
import { DEFAULT_LOCALE, t } from '../../lib/i18n';
import { formatEuros } from '../../lib/money';

interface Props {
	locale?: string;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const deals = [
	{ key: 'kitchen', company: 'Bouchon Gaspard', stage: 'qualified', amount: 17570, open: true },
	{ key: 'terrace', company: 'Le Jardin de Fourvière', stage: 'won', amount: 48880, open: false },
	{ key: 'central', company: 'Résidence Les Tilleuls', stage: 'proposal', amount: 42500, open: true },
	{ key: 'banquet', company: 'Hôtel Perrache Rive', stage: 'won', amount: 4920, open: false },
	{ key: 'tray', company: 'Cantine Gerland Campus', stage: 'lost', amount: 59200, open: false },
	{ key: 'pantry', company: 'Hôtel Vaise Gare', stage: 'proposal', amount: 14040, open: true },
];
const matches = (deal: (typeof deals)[number]): boolean => deal.open && deal.amount > 5000;
const view = deals.filter(matches).sort((a, b) => b.amount - a.amount);
---

<figure class="v4" data-saved-view>
	<ul class="v4__deals" aria-label={t(locale, 'site.savedView.allDeals')} data-i18n-aria-label="site.savedView.allDeals">
		{deals.map((deal) => (
			<li class="v4__card" data-out={matches(deal) ? undefined : ''}>
				<span class="v4__title" data-i18n={`site.savedView.deals.${deal.key}`}>{t(locale, `site.savedView.deals.${deal.key}`)}</span>
				<span class="v4__meta">{deal.company} · <span data-i18n={`site.savedView.stages.${deal.stage}`}>{t(locale, `site.savedView.stages.${deal.stage}`)}</span> · <span data-i18n-amount={deal.amount}>{formatEuros(locale, deal.amount)}</span></span>
			</li>
		))}
	</ul>
	<div class="v4__view">
		<div class="v4__chips" aria-label={t(locale, 'site.savedView.filters')} data-i18n-aria-label="site.savedView.filters">
			<span class="v4__chip" data-i18n="site.savedView.stageOpen">{t(locale, 'site.savedView.stageOpen')}</span>
			<span class="v4__chip" data-i18n="site.savedView.amountOver">{t(locale, 'site.savedView.amountOver')}</span>
			<span class="v4__chip" data-i18n="site.savedView.largestFirst">{t(locale, 'site.savedView.largestFirst')}</span>
		</div>
		<ol class="v4__rows" aria-label={t(locale, 'site.savedView.rows')} data-i18n-aria-label="site.savedView.rows">
			{view.map((deal) => (
				<li class="v4__row">
					<span class="v4__title">{deal.company}</span>
					<span class="v4__amount" data-i18n-amount={deal.amount}>{formatEuros(locale, deal.amount)}</span>
				</li>
			))}
		</ol>
	</div>
	<figcaption class="visually-hidden" data-i18n="site.savedView.caption">{t(locale, 'site.savedView.caption')}</figcaption>
</figure>

<style>
	.v4 {
		margin: 0 auto;
		width: min(100%, 52rem);
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
		gap: var(--space-5);
		align-items: start;
	}

	.v4__deals,
	.v4__rows {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: var(--space-2);
	}

	.v4__card,
	.v4__row,
	.v4__view {
		max-width: none;
		background: var(--raised);
		border: 1px solid var(--rule);
		border-radius: var(--radius-m);
	}

	.v4__card {
		display: grid;
		gap: 2px;
		padding: var(--space-2) var(--space-3);
	}

	/* Out of the view, but still readable: opacity would take the text under 4.5:1 (axe
	   color-contrast, 6 nodes in st3). Graphite on paper is 6.66:1 (D-017). */
	.v4__card[data-out] {
		background: transparent;
		border-style: dashed;
	}

	.v4__card[data-out] .v4__title,
	.v4__card[data-out] .v4__meta {
		color: var(--graphite);
	}

	.v4__view {
		display: grid;
		gap: var(--space-3);
		padding: var(--space-4);
		border-color: var(--ink);
		border-top: 3px solid var(--signal);
		box-shadow: var(--shadow-1);
	}

	.v4__chips {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
	}

	.v4__chip {
		padding: 2px var(--space-3);
		border: 1px solid var(--graphite);
		border-radius: var(--radius-pill);
		font-size: var(--step--1);
	}

	.v4__row {
		display: flex;
		justify-content: space-between;
		gap: var(--space-3);
		padding: var(--space-2) var(--space-3);
	}

	.v4__title {
		font-weight: 600;
	}

	.v4__meta,
	.v4__amount {
		color: var(--graphite);
		font-size: var(--step--1);
	}

	.v4[data-armed] .v4__card[data-out] {
		background: var(--raised);
		border-style: solid;
	}

	.v4[data-armed] .v4__card[data-out] .v4__title {
		color: inherit;
	}

	.v4[data-armed] .v4__row {
		color: var(--graphite);
		background: transparent;
		border-style: dashed;
		transform: translateY(calc(-1 * var(--space-3)));
	}

	.v4[data-play] .v4__card[data-out] {
		background: transparent;
		border-style: dashed;
		transition: background-color 400ms ease-out;
	}

	.v4[data-play] .v4__card[data-out] .v4__title {
		color: var(--graphite);
		transition: color 400ms ease-out;
	}

	.v4[data-play] .v4__row {
		color: var(--ink);
		background: var(--raised);
		border-style: solid;
		transform: none;
		transition:
			color 400ms ease-out,
			background-color 400ms ease-out,
			transform 400ms ease-out;
		transition-delay: calc(400ms + var(--i, 0) * 140ms);
	}

	/* The stagger index comes from position: the site's CSP (style-src without 'unsafe-inline')
	   blocks a style="--i: n" attribute. */
	.v4__row:nth-child(2) {
		--i: 1;
	}

	.v4__row:nth-child(3) {
		--i: 2;
	}
</style>
