---
// Click 1 (PLAN §1): the tour in a native <dialog>, opened by any [data-open-tour] link. Without
// JavaScript those links go to /tour, which shows the same TourPlayer. Under the player sits
// click 2, "Create your workspace".
import TourPlayer from './TourPlayer.astro';
import { TOUR } from '../../data/tour';
---

<dialog class="tour-dialog" aria-labelledby="tour-dialog-title" data-tour-dialog>
	<div class="tour-dialog__head">
		<h2 id="tour-dialog-title">{TOUR.title}</h2>
		<button class="button button--icon" type="button" data-close-tour aria-label="Close the tour">
			<svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false">
				<path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
			</svg>
		</button>
	</div>
	<TourPlayer />
	<div class="tour-dialog__next">
		<button class="button button--primary" type="button" data-open-portal>Create your workspace</button>
	</div>
</dialog>

<style>
	.tour-dialog {
		width: min(100% - 2 * var(--gutter), var(--wide-max));
		max-height: calc(100svh - 2 * var(--space-5));
		padding: var(--space-6);
		border: 1px solid var(--rule);
		border-radius: var(--radius-l);
		background: var(--raised);
		color: var(--ink);
		box-shadow: var(--shadow-2);
		overflow: auto;
	}

	.tour-dialog::backdrop {
		background: var(--scrim);
	}

	.tour-dialog__head {
		display: flex;
		align-items: start;
		justify-content: space-between;
		gap: var(--space-4);
		margin-bottom: var(--space-5);
	}

	.tour-dialog__head h2 {
		font-size: var(--step-2);
	}

	.tour-dialog__next {
		margin-top: var(--space-5);
	}

	@media (prefers-reduced-motion: no-preference) {
		.tour-dialog[open] {
			animation: tour-in var(--dur-base) var(--ease-out);
		}

		.tour-dialog[open]::backdrop {
			animation: tour-fade var(--dur-base) var(--ease-out);
		}
	}

	@keyframes tour-in {
		from {
			opacity: 0;
			transform: translateY(8px);
		}
	}

	@keyframes tour-fade {
		from {
			opacity: 0;
		}
	}
</style>
