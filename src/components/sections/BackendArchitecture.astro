---
import Eyebrow from '../brand/Eyebrow.astro';
import HexExplorer from './backend-architecture/HexExplorer.astro';
import StudioNetworkStory from './studio-network/StudioNetworkStory.astro';
---

<section class="section section--surface backend-arch" id="architecture">
	<div class="section__container">
		<header class="section__head">
			<Eyebrow icon="✶">Inside the studio</Eyebrow>
			<h2 class="section__title">One network for every database, app and team.</h2>
			<p class="section__lede">
				Prismatica joins your databases into one network. Each team builds on the part it is
				allowed to reach, and the explorer below lets you reshape the backend yourself.
			</p>
		</header>

		<StudioNetworkStory />

		<div class="backend-arch__explorer">
			<h3 class="backend-arch__explorer-title">Run the stack yourself</h3>
			<p class="backend-arch__explorer-lede">All 55 services from the grobase compose file. Start one and its
				dependencies start with it; stop one and everything that needs it stops too.</p>
			<HexExplorer />
		</div>
	</div>
</section>

<script>
	import { initHexExplorer } from './backend-architecture/hex-explorer';
	initHexExplorer();
</script>

<style is:global>
	/* Only the heading rhythm lives here; the explorer owns its own styles. */
	.backend-arch__explorer-title { margin-top: clamp(3rem, 8vw, 6rem); }
</style>
