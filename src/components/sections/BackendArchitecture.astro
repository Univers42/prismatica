---
import Eyebrow from '../brand/Eyebrow.astro';
import StackShowcase from './stack-showcase/StackShowcase.astro';
import StudioNetworkStory from './studio-network/StudioNetworkStory.astro';
import { t, DEFAULT_LOCALE, SUPPORTED_LOCALES, type SupportedLocale } from '../../lib/i18n';
import { normalizeLocale } from '../../lib/locale';

type Props = {
	readonly locale?: string;
};

const { locale = DEFAULT_LOCALE } = Astro.props;
const activeLocale = normalizeLocale(locale, {
	defaultLocale: DEFAULT_LOCALE,
	supportedLocales: SUPPORTED_LOCALES,
}) as SupportedLocale;
---

<section class="section section--surface backend-arch" id="architecture">
	<div class="section__container">
		<header class="section__head">
			<Eyebrow icon="✶" data-i18n="backendArchitecture.eyebrow">{t(activeLocale, 'backendArchitecture.eyebrow')}</Eyebrow>
			<h2 class="section__title" data-i18n="backendArchitecture.title">{t(activeLocale, 'backendArchitecture.title')}</h2>
			<p class="section__lede" data-i18n="backendArchitecture.lede">
				{t(activeLocale, 'backendArchitecture.lede')}
			</p>
		</header>

		<StudioNetworkStory locale={activeLocale} />

		<StackShowcase locale={activeLocale} />
	</div>
</section>

<script>
	import { initStackShowcase } from './stack-showcase/stack-showcase';
	initStackShowcase();
</script>
