---
// "Run the stack yourself": three slides on an iPad, chosen with tabs (or a
// swipe on touch screens): the live service graph, how it scales on
// Kubernetes, and the problems it removes. Portrait on phones, landscape
// from 1024px, beside the tabs from 1280px. stack-showcase.ts wires the
// slides together.
import ScaleDiagram from './ScaleDiagram.astro';
import StackGraph from './StackGraph.astro';
import WhySlide from './WhySlide.astro';
import '../../../styles/components/_devices.scss';

const SLIDES = [
	{ id: 'graph', name: 'Services', problem: 'Every new app needs its own backend. Here are 55 services, already wired.' },
	{ id: 'scale', name: 'Scaling', problem: 'Growing usually means re-platforming. Here the same stack scales out.' },
	{ id: 'why', name: 'Why us', problem: 'Work and data scattered across tools, and what replaces them.' },
];
---

<div class="showcase" data-showcase>
	<div class="showcase__intro">
		<h3 class="showcase__title">Run the stack yourself</h3>
		<p class="showcase__lede">The real grobase backend on a tablet: start and stop any of its services, watch a request cross it, then see how it grows.</p>
		<div class="showcase__tabs" role="tablist" aria-label="Stack slides">
			{SLIDES.map((slide, index) => (
				<button
					type="button"
					role="tab"
					class="showcase__tab"
					id={`showcase-tab-${slide.id}`}
					aria-controls={`showcase-panel-${slide.id}`}
					aria-selected={index === 0 ? 'true' : 'false'}
					tabindex={index === 0 ? 0 : -1}
					data-showcase-tab={slide.id}
				>
					<span class="showcase__tab-name">{slide.name}</span>
					<span class="showcase__tab-problem">{slide.problem}</span>
				</button>
			))}
		</div>
	</div>

	<div class="ipad">
		<div class="ipad__screen" data-showcase-screen>
			<div class="ipad__bar" aria-hidden="true"><span>grobase</span><span class="ipad__battery"></span></div>
			<div class="ipad__slides">
				{SLIDES.map((slide, index) => (
					<div
						role="tabpanel"
						class="ipad__slide"
						id={`showcase-panel-${slide.id}`}
						aria-labelledby={`showcase-tab-${slide.id}`}
						data-showcase-panel={slide.id}
						hidden={index !== 0}
					>
						{slide.id === 'graph' && <StackGraph />}
						{slide.id === 'scale' && <ScaleDiagram />}
						{slide.id === 'why' && <WhySlide />}
					</div>
				))}
			</div>
			<div class="ipad__dots" aria-hidden="true">
				{SLIDES.map((slide, index) => <span data-showcase-dot={slide.id} data-on={index === 0 ? '' : undefined}></span>)}
			</div>
		</div>
	</div>
</div>

<style is:global>
	.showcase { display: grid; gap: clamp(1.25rem, 4vw, 2rem); margin-top: clamp(3rem, 8vw, 6rem); }
	.showcase__intro { display: grid; gap: 0.75rem; min-width: 0; }
	:root .showcase__title { margin: 0; font-size: clamp(1.5rem, 5vw, 2.25rem); line-height: 1.05; letter-spacing: -0.025em; }
	.showcase__lede { max-width: 46ch; margin: 0; color: var(--system-text); line-height: 1.55; }

	/* Phones: a segmented control; the problem lines only fit beside the iPad. */
	.showcase__tabs {
		display: grid;
		grid-auto-columns: minmax(0, 1fr);
		grid-auto-flow: column;
		gap: 4px;
		margin-top: 0.25rem;
		padding: 4px;
		border-radius: var(--system-radius-pill);
		background: var(--system-surface-sunken);
	}

	.showcase__tab {
		position: relative;
		min-height: 44px;
		padding: 0.4rem 0.6rem;
		border: 0;
		border-radius: var(--system-radius-pill);
		background: transparent;
		color: var(--system-text);
		font: inherit;
		font-size: 0.9375rem;
		font-weight: 500;
		cursor: pointer;
		transition: background-color 160ms ease, color 160ms ease, box-shadow 160ms ease;
	}

	.showcase__tab[aria-selected='true'] { background: var(--system-surface); color: var(--system-text-strong); box-shadow: 0 1px 3px rgb(0 0 0 / 12%); }
	.showcase__tab:focus-visible { outline: 2px solid var(--system-focus-ring); outline-offset: 2px; }
	.showcase__tab-problem { display: none; }

	.ipad {
		--ipad-bezel: clamp(10px, 2.6vw, 18px);
		position: relative;
		justify-self: center;
		width: 100%;
		max-width: 34rem;
		padding: var(--ipad-bezel);
		border-radius: calc(var(--ipad-bezel) + 16px);
		background: var(--device-bezel);
		box-shadow: 0 0 0 1px var(--device-rim), 0 40px 60px -40px var(--device-shade);
	}

	.ipad::before {
		content: '';
		position: absolute;
		top: calc(var(--ipad-bezel) / 2 - 3px);
		left: calc(50% - 3px);
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--device-camera);
	}

	.ipad__screen {
		container: ipad / inline-size;
		display: grid;
		grid-template-rows: auto minmax(0, 1fr) auto;
		/* clip, not hidden: a scroll container loses aspect-ratio's
		   content-based minimum height, so a tall slide would be cut off. */
		overflow: clip;
		border-radius: 16px;
		background: var(--system-surface);
		color: var(--system-text);
	}

	.ipad__bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.45rem 1rem 0.2rem;
		font-size: 0.6875rem;
		font-weight: 600;
		color: var(--system-text-muted);
	}

	.ipad__battery { width: 20px; height: 9px; border: 1.5px solid currentColor; border-radius: 3px; box-shadow: inset 11px 0 0 -1px currentColor; }

	/* Slides share one grid cell, so the screen keeps the tallest slide's
	   height and switching never moves the page; hidden ones stay laid out. */
	.ipad__slides { display: grid; touch-action: pan-y; }
	.ipad__slide { grid-area: 1 / 1; min-width: 0; }
	.ipad__slide[hidden] { display: block; visibility: hidden; }

	.ipad__dots { display: flex; justify-content: center; gap: 6px; padding: 0.3rem 0 0.6rem; }
	.ipad__dots span { width: 6px; height: 6px; border-radius: 3px; background: var(--system-border-strong); transition: width 260ms var(--ease-premium, ease-out), background-color 260ms ease; }
	.ipad__dots span[data-on] { width: 18px; background: var(--system-text-strong); }

	@media (prefers-reduced-motion: no-preference) {
		:root:not(.motion-paused) .ipad__slide.is-entering { animation: ipad-slide-in 460ms var(--ease-premium, ease-out) both; }
		:root:not(.motion-paused) [data-direction='back'] .ipad__slide.is-entering { animation-name: ipad-slide-back; }
	}

	@keyframes ipad-slide-in { from { opacity: 0; translate: 28px 0; } }
	@keyframes ipad-slide-back { from { opacity: 0; translate: -28px 0; } }

	/* From 1024px the iPad turns landscape at full width under the intro;
	   from 1280px it sits beside the tabs, which become a list showing each
	   slide's problem line. */
	@media (min-width: 1024px) {
		.ipad { max-width: none; }
		.ipad__screen { aspect-ratio: 4 / 3; }
	}

	@media (min-width: 1280px) {
		.showcase { grid-template-columns: minmax(15rem, 0.32fr) minmax(0, 1fr); align-items: center; gap: clamp(2rem, 4vw, 3.5rem); }
		.showcase__tabs { grid-auto-flow: row; gap: 2px; padding: 0; border-radius: 0; background: none; }

		.showcase__tab {
			display: grid;
			gap: 0.2rem;
			padding: 0.75rem 1rem;
			border-radius: var(--system-radius-sm);
			text-align: left;
		}

		.showcase__tab:hover { background: var(--system-surface-sunken); }
		.showcase__tab[aria-selected='true'] { background: var(--system-surface-sunken); box-shadow: none; }

		.showcase__tab::before {
			content: '';
			position: absolute;
			inset: 10px auto 10px 0;
			width: 2px;
			background: var(--brand-palette-primary);
			transform: scaleY(0);
			transition: transform 260ms var(--ease-premium, ease-out);
		}

		.showcase__tab[aria-selected='true']::before { transform: scaleY(1); }
		.showcase__tab-name { font-weight: 600; }
		.showcase__tab-problem { display: block; font-size: 0.8125rem; font-weight: 400; line-height: 1.4; color: var(--system-text-muted); }
	}

	@media (prefers-reduced-motion: reduce) {
		.showcase__tab,
		.showcase__tab::before,
		.ipad__dots span { transition: none; }
	}
</style>
