---
// The first screen: a night sky of business items, all linked, over a planet
// (HeroUniverse), the promise in plain words, then the same workspace on a
// laptop, tablet and phone standing on the horizon (HeroDevices). When the
// laptop's workspace inserts an app, that app's items in the sky light up and
// beam down into it. The headline is the LCP element, so it carries no
// entrance animation.
import Button from '../ui/Button.astro';
import HeroUniverse from './hero/HeroUniverse.astro';
import HeroDevices from './hero/HeroDevices.astro';
import { t, DEFAULT_LOCALE, SUPPORTED_LOCALES, type SupportedLocale } from '../../lib/i18n';
import { normalizeLocale } from '../../lib/locale';

type Props = {
	readonly locale?: string;
};

const { locale = DEFAULT_LOCALE } = Astro.props;
const activeLocale = normalizeLocale(locale, {
	defaultLocale: DEFAULT_LOCALE,
	supportedLocales: SUPPORTED_LOCALES,
}) as SupportedLocale;
---

<section class="section section--hero hero-new" id="top" aria-labelledby="hero-title">
	<HeroUniverse />
	<div class="section__container hero-new__grid">
		<div class="hero-new__copy">
			<h1 class="hero-new__title" id="hero-title" data-i18n="hero.title">{t(activeLocale, 'hero.title')}</h1>
			<p class="hero-new__lede" data-i18n="hero.lede">{t(activeLocale, 'hero.lede')}</p>
			<div class="hero-new__cta">
				<Button variant="primary" size="lg" data-open-portal data-i18n="hero.startFree">{t(activeLocale, 'hero.startFree')}</Button>
				<Button variant="secondary" size="lg" href="#apps" data-i18n="hero.seeApps">{t(activeLocale, 'hero.seeApps')}</Button>
			</div>
			<p class="hero-new__note" data-i18n="hero.note">{t(activeLocale, 'hero.note')}</p>
		</div>

		<HeroDevices />
	</div>
	<!-- The sky and devices move on their own, so they get a pause (WCAG 2.2.2); scripts/theme.ts owns its state. -->
	<button id="motion-toggle" class="hero-new__motion" type="button" aria-pressed="false" aria-label="Pause animations" title="Pause animations">
		<svg class="hero-new__motion-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M5.5 3.5v9M10.5 3.5v9" /></svg>
		<svg class="hero-new__motion-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3.2 12.5 8 5 12.8Z" /></svg>
	</button>
</section>

<style is:global>
	/* A night scene in every theme, so its colours are local. `:root` lifts
	   specificity over the Swiss theme's `.section` rules. */
	:root .section.section--hero.hero-new {
		--sky-ink: #05070c;
		--sky-deep: #0d121e;
		--sky-text: #f4f5f7;
		--sky-signal: var(--brand-palette-primary);
		--sky-band: clamp(15rem, 62vw, 21rem);

		z-index: 2;
		/* The bottom keeps a strip clear for the pause button under the devices. */
		padding-block: calc(var(--sky-band) + 0.5rem) calc(clamp(2rem, 6vw, 4rem) + 2.5rem);
		border: 0;
		background: linear-gradient(180deg, var(--sky-ink) 0%, var(--sky-deep) 100%);
		color: var(--sky-text);
		overflow: clip;
	}

	.hero-new__motion {
		position: absolute;
		right: max(1rem, env(safe-area-inset-right));
		bottom: 0.75rem;
		z-index: 3;
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		padding: 0;
		border: 1px solid rgb(255 255 255 / 22%);
		border-radius: 50%;
		background: rgb(5 7 12 / 60%);
		color: var(--sky-text);
		cursor: pointer;
		backdrop-filter: blur(6px);
		transition: background-color 160ms ease-out;
	}

	.hero-new__motion:hover {
		background: rgb(255 255 255 / 14%);
	}

	.hero-new__motion:focus-visible {
		outline: 2px solid var(--sky-text);
		outline-offset: 3px;
	}

	.hero-new__motion svg {
		width: 1rem;
		height: 1rem;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 2;
	}

	.hero-new__motion-pause {
		fill: none;
	}

	.hero-new__motion-play {
		display: none;
		fill: currentColor;
	}

	.hero-new__motion[aria-pressed='true'] .hero-new__motion-pause {
		display: none;
	}

	.hero-new__motion[aria-pressed='true'] .hero-new__motion-play {
		display: block;
	}

	/* The system already stops the motion; there is nothing to pause. */
	@media (prefers-reduced-motion: reduce) {
		.hero-new__motion {
			display: none;
		}
	}

	.hero-new__grid {
		position: relative;
		z-index: 1;
		display: grid;
		justify-items: center;
		gap: clamp(2.75rem, 8vw, 4rem);
	}

	.hero-new__copy {
		display: grid;
		justify-items: center;
		gap: 1.1rem;
		min-width: 0;
		text-align: center;
	}

	:root .hero-new .hero-new__title {
		max-width: 13ch;
		margin: 0;
		font-family: var(--brand-font-display);
		font-size: clamp(2.45rem, 10.4vw, 4rem);
		font-weight: 600;
		line-height: 1.02;
		letter-spacing: -0.035em;
		text-wrap: balance;
		color: var(--sky-text);
	}

	.hero-new__lede {
		max-width: 40ch;
		margin: 0;
		font-size: clamp(1.0625rem, 4.1vw, 1.1875rem);
		line-height: 1.55;
		color: color-mix(in srgb, var(--sky-text) 74%, transparent);
	}

	.hero-new__cta {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.65rem;
		width: 100%;
		margin-top: 0.35rem;
	}

	/* Thumb-sized, full-width pair on phones; natural width from tablets up. */
	.hero-new__cta > * { flex: 1 1 9.5rem; justify-content: center; }

	:root .hero-new .ui-button--primary {
		border-color: var(--sky-text);
		background: var(--sky-text);
		color: var(--sky-ink);
	}

	:root .hero-new .ui-button--primary:hover {
		box-shadow: 0 0 0 4px color-mix(in srgb, var(--sky-text) 14%, transparent), 0 10px 34px -10px color-mix(in srgb, var(--sky-signal) 70%, transparent);
	}

	:root .hero-new .ui-button--secondary {
		border-color: color-mix(in srgb, var(--sky-text) 36%, transparent);
		background: transparent;
		color: var(--sky-text);
	}

	:root .hero-new .ui-button--secondary:hover { background: color-mix(in srgb, var(--sky-text) 8%, transparent); }

	.hero-new__note {
		margin: 0;
		font-size: 0.875rem;
		color: color-mix(in srgb, var(--sky-text) 58%, transparent);
	}

	@media (min-width: 640px) {
		.hero-new__cta > * { flex: 0 0 auto; }
	}

	@media (min-width: 1000px) {
		:root .section.section--hero.hero-new {
			--sky-band: 47.5rem;

			padding-block: clamp(4rem, 7vw, 6rem) clamp(3rem, 5vw, 4.5rem);
		}

		:root .hero-new .hero-new__title {
			max-width: 21ch;
			font-size: clamp(3.25rem, 5vw, 4.75rem);
		}
	}
</style>
