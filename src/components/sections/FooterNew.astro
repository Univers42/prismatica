---
import Button from '../ui/Button.astro';
import PrismaticaLogo from '../brand/PrismaticaLogo.astro';
import { t, DEFAULT_LOCALE, SUPPORTED_LOCALES, type SupportedLocale } from '../../lib/i18n';
import { normalizeLocale } from '../../lib/locale';

type Props = {
	readonly locale?: string;
};

const { locale = DEFAULT_LOCALE } = Astro.props;
const activeLocale = normalizeLocale(locale, {
	defaultLocale: DEFAULT_LOCALE,
	supportedLocales: SUPPORTED_LOCALES,
}) as SupportedLocale;

const year = new Date().getFullYear();

const groups = [
	{
		headingKey: 'footer.productGroup',
		links: [
			{ labelKey: 'nav.apps', href: '#apps' },
			{ labelKey: 'nav.product', href: '#product' },
			{ labelKey: 'nav.pricing', href: '#pricing' },
			{ labelKey: 'nav.docs', href: '/docs/' },
		],
	},
	{
		headingKey: 'footer.resourcesGroup',
		links: [
			{ labelKey: 'footer.quickstartLink', href: '/docs/quickstart/' },
			{ labelKey: 'footer.postgrestLink', href: '/docs/postgrest/' },
			{ labelKey: 'footer.gdprLink', href: '/docs/gdpr/' },
			{ labelKey: 'footer.authLink', href: '/docs/auth/' },
		],
	},
	{
		headingKey: 'footer.legalGroup',
		links: [
			{ labelKey: 'footer.privacyLink', href: '/legal/privacy-policy/' },
			{ labelKey: 'footer.termsLink', href: '/legal/terms/' },
			{ labelKey: 'footer.cookiesLink', href: '/legal/cookies/' },
			{ labelKey: 'footer.dataRightsLink', href: '/legal/data-rights/' },
		],
	},
	{
		headingKey: 'footer.groupCompany',
		links: [
			{ labelKey: 'footer.linkGithub', href: 'https://github.com/Univers42/track-binocle' },
		],
	},
] as const;
---

<footer class="footer-new" role="contentinfo">
	<div class="footer-new__inner">
		<section class="footer-new__newsletter-block">
			<a class="footer-new__brand" href="/">
				<span class="footer-new__logo" aria-hidden="true"><PrismaticaLogo decorative /></span>
				<span class="footer-new__wordmark">Prismatica</span>
			</a>
			<p class="footer-new__tagline" data-i18n="footer.tagline">{t(activeLocale, 'footer.tagline')}</p>

			<form class="footer-new__newsletter" action="/api/newsletter/subscribe" method="post" novalidate data-newsletter-signup>
				<label class="footer-new__newsletter-label" for="footer-newsletter-email" data-i18n="footer.newsletterLabel">{t(activeLocale, 'footer.newsletterLabel')}</label>
				<div class="footer-new__newsletter-row">
					<input id="footer-newsletter-email" type="email" name="email" autocomplete="email" placeholder="you@studio.io" required />
					<Button variant="primary" size="sm" type="submit"><span data-i18n="footer.newsletterButton">{t(activeLocale, 'footer.newsletterButton')}</span></Button>
				</div>
				<label class="footer-new__consent" for="footer-newsletter-consent">
					<input id="footer-newsletter-consent" type="checkbox" name="newsletter_consent" required />
					<span data-i18n="footer.newsletterConsent">{t(activeLocale, 'footer.newsletterConsent')}</span>
				</label>
				<div class="footer-new__newsletter-turnstile" data-turnstile-slot></div>
				<input type="hidden" name="turnstileToken" data-turnstile-token />
				<output class="footer-new__newsletter-status" data-newsletter-status aria-live="polite"></output>
				<p class="footer-new__newsletter-meta" data-i18n="footer.newsletterMeta">{t(activeLocale, 'footer.newsletterMeta')}</p>
			</form>
		</section>

		<nav class="footer-new__nav" aria-label="Footer">
			{groups.map((group) => (
				<div class="footer-new__group">
					<h3 class="footer-new__heading" data-i18n={group.headingKey}>{t(activeLocale, group.headingKey as any)}</h3>
					<ul role="list">
						{group.links.map((link) => (
							<li><a href={link.href} data-i18n={link.labelKey}>{t(activeLocale, link.labelKey as any)}</a></li>
						))}
						{group.headingKey === 'footer.legalGroup' && (
							<li><button class="footer-new__link-button" type="button" data-manage-cookies data-i18n="footer.cookieSettings">{t(activeLocale, 'footer.cookieSettings' as any)}</button></li>
						)}
					</ul>
				</div>
			))}
		</nav>
	</div>

	<div class="footer-new__base">
		<p data-i18n="footer.copyright">{t(activeLocale, 'footer.copyright', { year: String(year) })}</p>
		<p class="footer-new__gdpr"><span data-i18n="footer.gdprContact">{t(activeLocale, 'footer.gdprContact')}</span> <a href="mailto:dev.pro.photo@gmail.com">dev.pro.photo@gmail.com</a></p>
		<ul class="footer-new__social" role="list">
			<li><a href="https://github.com/Univers42/track-binocle" aria-label="GitHub">GitHub</a></li>
		</ul>
	</div>
</footer>

<style is:global>
	.footer-new {
		position: relative;
		z-index: 10;
		background: color-mix(in srgb, var(--brand-canvas-bg) 92%, transparent);
		border-top: 1px solid var(--brand-canvas-line-strong);
		color: var(--system-text);
		font-family: var(--system-font-sans);
	}
	.footer-new__inner {
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.4fr);
		gap: clamp(2rem, 4vw, 3.5rem);
		max-width: 1200px;
		margin: 0 auto;
		padding: clamp(2.5rem, 5vw, 4rem) 1.5rem;
	}
	@media (max-width: 820px) {
		.footer-new__inner {
			grid-template-columns: 1fr;
		}
	}
	.footer-new__brand {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		text-decoration: none;
		color: var(--system-text);
		font-weight: 700;
		font-size: 1.15rem;
		margin-bottom: 0.75rem;
	}
	.footer-new__brand:focus-visible {
		outline: 3px solid var(--system-focus-ring);
		outline-offset: 3px;
		border-radius: var(--system-radius-xs);
	}
	.footer-new__logo {
		display: inline-flex;
		width: 1.5rem;
		height: 1.5rem;
	}
	.footer-new__tagline {
		margin: 0 0 1.5rem;
		font-size: 0.95rem;
		color: var(--system-text-muted);
		max-width: 38ch;
	}
	.footer-new__newsletter-label {
		display: block;
		font-size: 0.86rem;
		font-weight: 600;
		color: var(--system-text);
		margin-bottom: 0.4rem;
	}
	.footer-new__newsletter-row {
		display: flex;
		gap: 0.5rem;
	}
	.footer-new__newsletter-row input {
		flex: 1;
		min-height: 40px;
		padding: 0.55rem 0.75rem;
		border: 1px solid var(--system-input-border);
		border-radius: var(--system-radius-sm);
		background: var(--system-input-bg);
		color: var(--system-input-fg);
		font: inherit;
	}
	.footer-new__newsletter-row input:focus-visible {
		outline: 0;
		border-color: var(--system-input-border-focus);
		box-shadow: var(--system-input-shadow-focus);
	}
	.footer-new__consent {
		display: grid;
		grid-template-columns: auto 1fr;
		align-items: start;
		gap: 0.55rem;
		margin-top: 0.6rem;
		font-size: 0.8rem;
		line-height: 1.35;
		color: var(--system-text-muted);
		cursor: pointer;
	}
	.footer-new__consent input {
		margin: 0;
		margin-top: 0.18rem;
		accent-color: var(--brand-palette-secondary);
	}
	.footer-new__consent input:focus-visible {
		outline: 2px solid var(--system-focus-ring);
		outline-offset: 2px;
	}
	.footer-new__newsletter-status {
		display: block;
		min-height: 1.35rem;
		margin-top: 0.4rem;
		font-size: 0.85rem;
	}
	.footer-new__newsletter-status:empty { display: none; }
	.footer-new__newsletter-status.is-success { color: var(--system-success); }
	.footer-new__newsletter-status.is-error { color: var(--system-danger); }
	.footer-new__newsletter-meta {
		margin: 0.3rem 0 0;
		font-size: 0.78rem;
		color: var(--system-text-muted);
	}
	.footer-new__nav {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
		gap: 1.75rem;
	}
	.footer-new__heading {
		font-family: var(--system-font-sans);
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--system-text-muted);
		margin: 0 0 0.9rem;
	}
	.footer-new__group ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.footer-new__group li {
		margin-bottom: 0.55rem;
	}
	.footer-new__group a,
	.footer-new__link-button {
		color: var(--system-text);
		text-decoration: none;
		font-size: 0.92rem;
	}
	.footer-new__link-button {
		padding: 0;
		border: 0;
		background: none;
		font: inherit;
		font-size: 0.92rem;
		text-align: start;
		cursor: pointer;
	}
	.footer-new__group a:hover,
	.footer-new__link-button:hover { color: var(--system-link-hover); text-decoration: underline; }
	.footer-new__group a:focus-visible,
	.footer-new__link-button:focus-visible {
		outline: 3px solid var(--system-focus-ring);
		outline-offset: 2px;
		border-radius: var(--system-radius-sm);
	}
	.footer-new__base {
		border-top: 1px solid var(--brand-canvas-line);
		padding: 1.5rem;
		max-width: 1200px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 1rem;
		font-size: 0.86rem;
		color: var(--system-text-muted);
	}
	.footer-new__base p { margin: 0; }
	.footer-new__gdpr a {
		color: var(--system-text);
		text-decoration: underline;
	}
	.footer-new__social {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.footer-new__social a {
		color: var(--system-text);
		text-decoration: none;
	}
	.footer-new__social a:hover { text-decoration: underline; }
</style>