---
import { GROUPS, PRESETS, SERVICES, type ServiceGroup } from '../../../data/grobase-services';

// WHY: the markup is stacked in request-flow order so the base (mobile) layout
// reads top-down as a request travels: in at the edge, operated, through the
// core, past control, down to the driven adapters, then ops.
const STACK_ORDER: ServiceGroup[] = ['edge', 'tools', 'core', 'control', 'data', 'engines', 'ops'];
const CAPTIONS: Record<ServiceGroup, string> = {
	core: 'The domain: business services',
	edge: 'Driving adapters: requests come in',
	tools: 'Driving adapters: people operate it',
	control: 'Ports: tenancy, secrets, policy',
	data: 'Driven adapters: execution',
	engines: 'Driven adapters: where data lives',
	ops: 'Observability and jobs',
};
const stack = STACK_ORDER.map((id) => {
	const group = GROUPS.find((entry) => entry.id === id);
	if (!group) throw new Error(`unknown group ${id}`);
	return group;
});
const servicesIn = (group: ServiceGroup) => SERVICES.filter((service) => service.group === group);
// Totals in the HUD are real counts from the compose snapshot, never invented.
---

<div class="hex" data-hex data-scroll-grow>
	<div class="hex__bar">
		<div class="hex__presets" role="group" aria-label="Start a preset">
			{PRESETS.map((preset) => (
				<button type="button" class="hex__preset" data-preset={preset.id} aria-pressed="false">{preset.label}</button>
			))}
		</div>
		<dl class="hex__hud">
			<div><dt>Running</dt><dd data-hud="running">—</dd></div>
			<div><dt>Engines</dt><dd data-hud="engines">—</dd></div>
			<div><dt>Query path</dt><dd data-hud="path">—</dd></div>
			<div><dt>Change events</dt><dd data-hud="events">—</dd></div>
		</dl>
	</div>
	<div class="hex__board">
		{stack.map((group) => (
			<section class={`hex__cell hex__cell--${group.id}`} aria-labelledby={`hex-${group.id}`}>
				<h4 id={`hex-${group.id}`}>{group.label}</h4>
				<p class="hex__side">{CAPTIONS[group.id]}</p>
				<ul class="hex__chips">
					{servicesIn(group.id).map((service) => (
						<li>
							<button
								type="button"
								class="hex__chip"
								data-service={service.id}
								data-kind={service.kind}
								aria-pressed="false"
								aria-describedby="hex-detail"
							>{service.name}</button>
						</li>
					))}
				</ul>
			</section>
		))}
		<svg class="hex__wires" aria-hidden="true" focusable="false">
			<path class="hex__wire" data-wire pathLength="1" />
		</svg>
	</div>
	<ol class="hex__pipeline" aria-label="Universal query path"></ol>
	<p class="hex__detail" id="hex-detail" role="status" aria-live="polite">Pick a service to see what it needs.</p>
</div>

<style is:global>
	.hex {
		display: grid;
		border: 1px solid var(--system-border-strong);
		border-radius: var(--system-radius-xl);
		background: var(--system-surface);
		box-shadow: var(--system-shadow-3);
		overflow: hidden;
	}
	.hex__bar {
		display: grid;
		gap: 0.6rem;
		padding: 0.7rem 0.9rem;
		background: var(--system-surface-sunken);
		border-bottom: 1px solid var(--system-border);
	}
	.hex__presets { display: flex; flex-wrap: wrap; gap: 0.4rem; }
	.hex__preset {
		font-size: 0.78rem; font-weight: 600; padding: 0.3rem 0.8rem; min-height: 2.75rem;
		border: 1px solid var(--system-border); border-radius: var(--system-radius-pill);
		background: var(--system-surface); color: var(--system-text); cursor: pointer;
	}
	.hex__preset[aria-pressed='true'] { background: var(--system-action-bg); border-color: var(--system-action-bg); color: var(--system-action-fg); }
	.hex__preset:focus-visible, .hex__chip:focus-visible { outline: 3px solid var(--system-focus-ring); outline-offset: 2px; }
	.hex__hud { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.6rem 1.1rem; margin: 0; }
	.hex__hud > div { display: grid; gap: 0.05rem; min-width: 0; }
	.hex__hud dt { font-family: var(--system-font-mono); font-size: 0.62rem; color: var(--system-text-muted); text-transform: uppercase; letter-spacing: 0.1em; }
	.hex__hud dd { margin: 0; font-size: 0.92rem; font-weight: 700; color: var(--system-text-strong); font-variant-numeric: tabular-nums; }

	.hex__board { position: relative; display: grid; gap: 0.55rem; padding: 0.6rem; }
	.hex__cell {
		min-width: 0; padding: 0.55rem 0.65rem 0.65rem;
		border: 1px solid var(--system-border); border-radius: var(--system-radius-md);
		background: var(--system-surface);
	}
	.hex__cell h4 { margin: 0; font-size: 0.85rem; color: var(--system-text-strong); }
	.hex__side { margin: 0.1rem 0 0.55rem; font-size: 0.72rem; color: var(--system-text-muted); }
	.hex__chips { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0; padding: 0; list-style: none; }
	.hex__chip {
		display: inline-flex; align-items: center; gap: 0.35rem;
		min-height: 2.75rem; padding: 0.3rem 0.7rem;
		border: 1px solid var(--system-border); border-radius: var(--system-radius-pill);
		background: var(--system-surface-sunken); color: var(--system-text-muted);
		font-size: 0.78rem; font-weight: 500; cursor: pointer;
	}
	.hex__chip[aria-pressed='true'] {
		border-color: color-mix(in srgb, var(--brand-palette-primary) 55%, var(--system-border));
		background: color-mix(in srgb, var(--brand-palette-primary) 14%, var(--system-surface));
		color: var(--system-text-strong);
	}
	/* Running chips get their dot live; off chips stay bare to read as outlines. */
	.hex__chip::before { content: ''; display: none; width: 6px; height: 6px; border-radius: 50%; flex: none; }
	.hex__chip[aria-pressed='true']::before { display: inline-block; background: var(--brand-palette-primary); }
	.hex__chip[data-kind='job'] { border-style: dashed; font-size: 0.7rem; padding-block: 0.15rem; }
	.hex__chip[data-needs] { outline: 2px solid var(--brand-palette-primary); outline-offset: 2px; }
	.hex__chip[data-needed-by] { outline: 2px dashed var(--brand-palette-secondary); outline-offset: 2px; }
	/* Query-path chips carry their step number as a CSS-only badge. */
	.hex__chip[data-hop]::after {
		content: attr(data-hop); margin-left: 0.15rem; padding: 0 0.3rem;
		border-radius: var(--system-radius-pill);
		background: var(--brand-palette-primary); color: var(--system-surface);
		font-size: 0.62rem; font-weight: 700; font-variant-numeric: tabular-nums;
	}
	.hex__wires { display: none; }

	/* Vertical rail: one line over the whole path, one row per hop. */
	.hex__pipeline {
		position: relative; display: grid; gap: 0.35rem;
		margin: 0; padding: 0.85rem 0.9rem 0.9rem 0.7rem; list-style: none;
		border-top: 1px solid var(--system-border);
	}
	.hex__pipeline::before { content: ''; position: absolute; left: 1.42rem; top: 1.1rem; bottom: 1.05rem; width: 2px; background: var(--system-border); }
	.hex__pipeline li { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.2rem 0.6rem; }
	.hex__hop-num {
		display: inline-grid; place-items: center; width: 1.5rem; height: 1.5rem; flex: none; align-self: center;
		border: 1px solid var(--system-border-strong); border-radius: 50%; background: var(--system-surface);
		font-family: var(--system-font-mono); font-size: 0.7rem; color: var(--system-text-strong);
	}
	.hex__hop-name { font-size: 0.85rem; font-weight: 600; color: var(--system-text-strong); }
	.hex__hop-label { flex: 1 1 12rem; font-size: 0.78rem; color: var(--system-text-muted); }
	.hex__hop-state { font-family: var(--system-font-mono); font-size: 0.66rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--system-success-text); }
	.hex__pipeline li[data-on='false'] .hex__hop-name, .hex__pipeline li[data-on='false'] .hex__hop-label, .hex__pipeline li[data-on='false'] .hex__hop-state { color: var(--system-text-muted); }
	/* Off hops stay muted; the first off hop per phase is the blocked one and is
	   called out in the brand primary instead. */
	.hex__pipeline li[data-blocked='true'] .hex__hop-name { color: var(--brand-palette-primary); }
	.hex__pipeline li[data-blocked='true'] .hex__hop-state { color: var(--brand-palette-primary); font-weight: 700; }
	.hex__pipeline li[data-blocked='true'] .hex__hop-num { border-color: var(--brand-palette-primary); color: var(--brand-palette-primary); }
	.hex__pipeline li[data-phase-break='true'] { margin-top: 0.7rem; }

	.hex__detail {
		min-height: 3.2rem; margin: 0; padding: 0.7rem 0.9rem;
		border-top: 1px solid var(--system-border); background: var(--system-surface-sunken);
		font-size: 0.82rem; color: var(--system-text);
	}

	@media (pointer: fine) {
		.hex__preset, .hex__chip { min-height: 2.125rem; }
	}

	@media (min-width: 1024px) {
		.hex__bar { grid-template-columns: auto 1fr; align-items: start; gap: 0.6rem 1.4rem; }
		/* One row with dividers once there is room; wrapped, they stranded a rule at a line start. */
		.hex__hud { display: flex; flex-wrap: wrap; justify-content: end; gap: 0.3rem 1.1rem; }
		.hex__hud > div + div { border-left: 1px solid var(--system-border); padding-left: 1.1rem; }
		/* Honeycomb: ports around the hexagonal core, driven adapters below. */
		.hex__board {
			grid-template-areas: '. control .' 'edge core data' 'tools core engines' '. ops .';
			grid-template-columns: 1fr 1.35fr 1fr;
			align-items: stretch;
		}
		.hex__cell--core { grid-area: core; border: 0; padding-inline: 11%; clip-path: polygon(10% 0, 90% 0, 100% 50%, 90% 100%, 10% 100%, 0 50%); }
		.hex__cell--edge, .hex__cell--tools { clip-path: polygon(0 0, calc(100% - 12px) 0, 100% 12px, 100% calc(100% - 12px), calc(100% - 12px) 100%, 0 100%); }
		.hex__cell--edge { grid-area: edge; }
		.hex__cell--tools { grid-area: tools; }
		.hex__cell--data { grid-area: data; clip-path: polygon(12px 0, 100% 0, 100% 100%, 12px 100%, 0 calc(100% - 12px), 0 12px); }
		.hex__cell--engines { grid-area: engines; clip-path: polygon(12px 0, 100% 0, 100% 100%, 12px 100%, 0 calc(100% - 12px), 0 12px); }
		.hex__cell--control { grid-area: control; clip-path: polygon(0 0, 100% 0, 100% calc(100% - 12px), calc(100% - 12px) 100%, 12px 100%, 0 calc(100% - 12px)); }
		.hex__cell--ops { grid-area: ops; clip-path: polygon(12px 0, calc(100% - 12px) 0, 100% 12px, 100% 100%, 0 100%, 0 12px); }
		/* The wire runs under the cells, which turn translucent so it shows
		   through them and disappears behind each chip it passes. */
		.hex__cell { position: relative; z-index: 2; background: color-mix(in srgb, var(--system-surface) 78%, transparent); }
		.hex__wires { display: block; position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 1; }
		.hex__wire { fill: none; stroke: var(--brand-palette-primary); stroke-width: 1.5; stroke-linejoin: round; opacity: 0.7; }
		.hex__packet { fill: var(--brand-palette-primary); stroke: var(--system-surface); stroke-width: 1; visibility: hidden; }
		/* Request and events phases stay separated in the horizontal rail too. */
		.hex__pipeline { display: flex; flex-wrap: wrap; gap: 0.35rem 1rem; align-items: baseline; }
		.hex__pipeline li[data-phase-break='true'] { margin-top: 0; margin-left: 1.2rem; position: relative; padding-left: 1.1rem; }
		.hex__pipeline li[data-phase-break='true']::before { content: ''; position: absolute; left: 0.5rem; top: 0.15rem; bottom: 0.15rem; width: 1px; background: var(--system-border-strong); }
	}

	/* Wire draw-in and plain hover transitions are the only motion here; the
	   packet is driven from the script and killed below when not allowed. */
	@media (prefers-reduced-motion: no-preference) {
		:root:not(.motion-paused) .hex__preset,
		:root:not(.motion-paused) .hex__chip {
			transition: background 160ms var(--system-ease-standard), border-color 160ms var(--system-ease-standard), color 160ms var(--system-ease-standard), outline-color 160ms var(--system-ease-standard);
		}
		:root:not(.motion-paused) .hex__wires[data-packet='true'] .hex__packet { visibility: visible; transform-box: view-box; }
		:root:not(.motion-paused) .hex__wire { stroke-dasharray: 1; stroke-dashoffset: 1; }
		:root:not(.motion-paused) .hex__wire[data-drawn='true'] {
			stroke-dashoffset: 0;
			transition: stroke-dashoffset 900ms var(--system-ease-standard);
		}
	}
	/* Kill switch if the visitor pauses motion after the packet was started. */
	@media (prefers-reduced-motion: reduce) {
		.hex__packet { visibility: hidden !important; }
	}
	:root.motion-paused .hex__packet { visibility: hidden !important; }
</style>
