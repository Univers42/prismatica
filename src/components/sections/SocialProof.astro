---
import Card from '../ui/Card.astro';
import Eyebrow from '../brand/Eyebrow.astro';
import { t, DEFAULT_LOCALE, SUPPORTED_LOCALES, type SupportedLocale } from '../../lib/i18n';
import { normalizeLocale } from '../../lib/locale';

type Props = {
	readonly locale?: string;
};

const { locale = DEFAULT_LOCALE } = Astro.props;
const activeLocale = normalizeLocale(locale, {
	defaultLocale: DEFAULT_LOCALE,
	supportedLocales: SUPPORTED_LOCALES,
}) as SupportedLocale;

const quotes = [
	{
		quoteKey: 'socialProof.quote1',
		roleKey: 'socialProof.role1',
		name: 'Amelia Hart',
		company: 'Northwave Studios',
	},
	{
		quoteKey: 'socialProof.quote2',
		roleKey: 'socialProof.role2',
		name: 'Jonas Reuter',
		company: 'Kollektiv DE',
	},
	{
		quoteKey: 'socialProof.quote3',
		roleKey: 'socialProof.role3',
		name: 'Noor Janssen',
		company: 'Axiom Lab',
	},
] as const;
---

<section class="section section--surface social-proof">
	<div class="section__container">
		<header class="section__head">
			<Eyebrow data-i18n="socialProof.eyebrow">{t(activeLocale, 'socialProof.eyebrow')}</Eyebrow>
			<h2 class="section__title" data-i18n="socialProof.title">{t(activeLocale, 'socialProof.title')}</h2>
		</header>

		<div class="social-proof__grid">
			{quotes.map((q) => (
				<div data-scroll-rise>
					<Card variant="testimonial">
						<blockquote class="social-proof__quote" data-i18n={q.quoteKey}>{t(activeLocale, q.quoteKey as any)}</blockquote>
						<footer class="social-proof__author">
							<span class="social-proof__avatar" aria-hidden="true">{q.name.split(' ').map((n) => n[0]).join('')}</span>
							<div>
								<strong>{q.name}</strong>
								<span><span data-i18n={q.roleKey}>{t(activeLocale, q.roleKey as any)}</span> · {q.company}</span>
							</div>
						</footer>
					</Card>
				</div>
			))}
		</div>
	</div>
</section>
<style is:global>
	.social-proof__grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 1.5rem;
	}
	/* Equal-height cards with the author on the bottom line, whatever the quote length. */
	.social-proof__grid > * > .ui-card {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		height: 100%;
	}
	.social-proof__author { margin-top: auto; }
	.social-proof__quote {
		margin: 0;
		font-size: 1rem;
		line-height: 1.55;
		color: var(--system-text);
	}
	.social-proof__author {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		font-size: 0.85rem;
	}
	.social-proof__author strong {
		display: block;
		color: var(--system-text-strong);
	}
	.social-proof__author span {
		color: var(--system-text-muted);
	}
	.social-proof__avatar {
		display: grid;
		place-items: center;
		width: 38px;
		height: 38px;
		border-radius: 50%;
		background: var(--system-action-secondary-bg);
		color: var(--system-action-bg);
		font-weight: 700;
		font-size: 0.82rem;
	}
</style>