---
// The app tour: one tab per connected app over a large media stage, then the
// phone band. Tabs are a swipeable chip row on phones and a vertical list from
// 1000px. Each panel shows its app's capture from media-shots.ts, or a drawn
// sketch where none exists yet.
import AppGlyph from '../ui/AppGlyph.astro';
import MediaSlot from '../ui/MediaSlot.astro';
import AppSketch from './hero/AppSketch.astro';
import { CONNECTED_APPS, appName, type ConnectedAppId } from '../../data/connected-apps';
import { MEDIA_SHOTS } from '../../data/media-shots';
import { t, DEFAULT_LOCALE, SUPPORTED_LOCALES, type SupportedLocale } from '../../lib/i18n';
import { normalizeLocale } from '../../lib/locale';

type Props = {
	readonly locale?: string;
};

const { locale = DEFAULT_LOCALE } = Astro.props;
const activeLocale = normalizeLocale(locale, {
	defaultLocale: DEFAULT_LOCALE,
	supportedLocales: SUPPORTED_LOCALES,
}) as SupportedLocale;

const APP_KEYS: Record<ConnectedAppId, { nameKey: string; hintKey: string; summaryKey: string }> = {
	docs: { nameKey: 'appTour.appDocsName', hintKey: 'appTour.appDocsHint', summaryKey: 'appTour.appDocsSummary' },
	database: { nameKey: 'appTour.appDatabaseName', hintKey: 'appTour.appDatabaseHint', summaryKey: 'appTour.appDatabaseSummary' },
	board: { nameKey: 'appTour.appBoardName', hintKey: 'appTour.appBoardHint', summaryKey: 'appTour.appBoardSummary' },
	calendar: { nameKey: 'appTour.appCalendarName', hintKey: 'appTour.appCalendarHint', summaryKey: 'appTour.appCalendarSummary' },
	mail: { nameKey: 'appTour.appMailName', hintKey: 'appTour.appMailHint', summaryKey: 'appTour.appMailSummary' },
	whiteboard: { nameKey: 'appTour.appWhiteboardName', hintKey: 'appTour.appWhiteboardHint', summaryKey: 'appTour.appWhiteboardSummary' },
};
---

<section class="section app-tour" id="apps" aria-labelledby="app-tour-title">
	<div class="section__container">
		<header class="app-tour__head" data-reveal="head">
			<h2 class="section__title" id="app-tour-title" data-i18n="appTour.title">{t(activeLocale, 'appTour.title')}</h2>
			<p class="section__lede" data-i18n="appTour.lede">
				{t(activeLocale, 'appTour.lede')}
			</p>
		</header>

		<div class="app-tour__body" data-app-tour data-scroll-grow>
			<div class="app-tour__tabs" role="tablist" aria-label="Apps">
				{CONNECTED_APPS.map((app, index) => {
					const keys = APP_KEYS[app.id];
					return (
						<button
							type="button"
							role="tab"
							class="app-tour__tab"
							id={`app-tab-${app.id}`}
							aria-controls={`app-panel-${app.id}`}
							aria-selected={index === 0 ? 'true' : 'false'}
							tabindex={index === 0 ? 0 : -1}
							data-app-tab={app.id}
						>
							<AppGlyph name={app.id} />
							<span class="app-tour__tab-text">
								<span class="app-tour__tab-name" data-i18n={keys?.nameKey}>{keys ? t(activeLocale, keys.nameKey as any) : app.name}</span>
								<span class="app-tour__tab-hint" data-i18n={keys?.hintKey}>{keys ? t(activeLocale, keys.hintKey as any) : app.hint}</span>
							</span>
						</button>
					);
				})}
			</div>

			<div class="app-tour__panels">
				{CONNECTED_APPS.map((app, index) => {
					const keys = APP_KEYS[app.id];
					return (
						<div
							role="tabpanel"
							class="app-tour__panel"
							id={`app-panel-${app.id}`}
							aria-labelledby={`app-tab-${app.id}`}
							data-app-panel={app.id}
							hidden={index !== 0}
						>
							<MediaSlot shot={app.shot} frame="browser"><AppSketch name={app.id} /></MediaSlot>
							<div class="app-tour__caption">
								<p class="app-tour__summary" data-i18n={keys?.summaryKey}>{keys ? t(activeLocale, keys.summaryKey as any) : app.summary}</p>
								<p class="app-tour__links">
									<span data-i18n="appTour.worksWith">{t(activeLocale, 'appTour.worksWith')}</span>
									{app.links.map((link) => {
										const linkKeys = APP_KEYS[link];
										return <span class="app-tour__link" data-i18n={linkKeys?.nameKey}>{linkKeys ? t(activeLocale, linkKeys.nameKey as any) : appName(link)}</span>;
									})}
								</p>
							</div>
						</div>
					);
				})}
			</div>
		</div>

		<div class="app-tour__pocket" data-scroll-rise>
			<div class="app-tour__pocket-copy">
				<h3 class="app-tour__pocket-title" data-i18n="appTour.pocketTitle">{t(activeLocale, 'appTour.pocketTitle')}</h3>
				<p data-i18n="appTour.pocketLede">
					{t(activeLocale, 'appTour.pocketLede')}
				</p>
			</div>
			<MediaSlot shot={MEDIA_SHOTS.mobile} frame="phone" class="app-tour__phone" />
		</div>
	</div>
</section>

<script>
	import { bindTabs } from '../../lib/tabs';
	const root = document.querySelector<HTMLElement>('[data-app-tour]');
	if (root) bindTabs(root, 'app');
</script>

<style is:global>
	.app-tour__head { display: grid; gap: 0.75rem; margin-bottom: clamp(1.5rem, 5vw, 2.75rem); }
	.app-tour__head .section__title { max-width: 18ch; margin: 0; }
	.app-tour__head .section__lede { margin: 0; }

	.app-tour__body {
		display: grid;
		gap: 1rem;
		min-width: 0;
	}

	/* Phones: a chip row that scrolls sideways, bleeding to the screen edge
	   (4vw = the gutter left by .section__container at 92vw). */
	.app-tour__tabs {
		display: flex;
		gap: 0.5rem;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		padding: 0 4vw 0.5rem;
		margin: 0 -4vw;
		scrollbar-width: none;
	}
	.app-tour__tabs::-webkit-scrollbar { display: none; }

	.app-tour__tab {
		flex: none;
		scroll-snap-align: start;
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		padding: 0.55rem 0.95rem;
		border-radius: var(--system-radius-pill);
		border: 1px solid var(--system-border-strong);
		background: var(--system-surface);
		color: var(--system-text);
		font: inherit;
		cursor: pointer;
		transition: background-color 160ms ease, border-color 160ms ease, color 160ms ease;
	}

	.app-tour__tab-text { display: grid; text-align: left; }
	.app-tour__tab-name { font-size: 0.9375rem; font-weight: 600; color: inherit; }
	.app-tour__tab-hint { font-size: 0.75rem; color: var(--system-text-muted); }

	.app-tour__tab[aria-selected='true'] {
		background: var(--system-text-strong);
		border-color: var(--system-text-strong);
		color: var(--system-surface);
	}
	.app-tour__tab[aria-selected='true'] .app-tour__tab-hint {
		color: color-mix(in srgb, var(--system-surface) 75%, transparent);
	}
	.app-tour__tab:focus-visible { outline: 2px solid var(--system-focus-ring); outline-offset: 2px; }

	.app-tour__panels {
		min-width: 0;
	}
	.app-tour__panel[hidden] { display: none; }

	.app-tour__caption {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.75rem 1.5rem;
		margin-top: 1rem;
		padding: 0 0.25rem;
	}
	.app-tour__summary {
		max-width: 58ch;
		margin: 0;
		font-size: 1rem;
		line-height: 1.5;
		color: var(--system-text);
	}
	.app-tour__links {
		display: inline-flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem;
		margin: 0;
		font-size: 0.8125rem;
		color: var(--system-text-muted);
	}
	.app-tour__link {
		padding: 0.15rem 0.55rem;
		border-radius: var(--system-radius-pill);
		background: var(--system-surface-sunken);
		border: 1px solid var(--system-border);
		color: var(--system-text-strong);
		font-weight: 500;
	}

	.app-tour__pocket {
		display: grid;
		gap: 1.5rem;
		margin-top: clamp(3rem, 7vw, 5.5rem);
		padding: clamp(1.5rem, 4vw, 2.75rem);
		border-radius: var(--system-radius-lg);
		background: var(--system-surface-sunken);
		border: 1px solid var(--system-border);
	}
	.app-tour__pocket-copy { display: grid; gap: 0.6rem; max-width: 44ch; }
	.app-tour__pocket-title { margin: 0; font-size: clamp(1.25rem, 3vw, 1.75rem); line-height: 1.2; }
	.app-tour__pocket-copy p { margin: 0; line-height: 1.55; }
	.app-tour__phone { max-width: 320px; justify-self: center; }

	/* Desktop layout from 1000px: vertical tabs on the left, media on the right. */
	@media (min-width: 1000px) {
		.app-tour__body {
			grid-template-columns: minmax(18rem, 0.38fr) minmax(0, 1fr);
			gap: clamp(2rem, 4vw, 3.5rem);
			align-items: start;
		}
		.app-tour__tabs {
			display: grid;
			grid-auto-flow: row;
			gap: 0.35rem;
			padding: 0;
			margin: 0;
			overflow-x: visible;
		}
		.app-tour__tab {
			width: 100%;
			padding: 0.85rem 1.1rem;
			border-radius: var(--system-radius-md);
			box-sizing: border-box;
		}
		.app-tour__pocket {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			align-items: center;
			gap: 3rem;
		}
	}
</style>