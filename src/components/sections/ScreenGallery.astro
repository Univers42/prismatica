---
import MediaSlot from '../ui/MediaSlot.astro';
import { MEDIA_SHOTS } from '../../data/media-shots';
import { t, DEFAULT_LOCALE, SUPPORTED_LOCALES, type SupportedLocale } from '../../lib/i18n';
import { normalizeLocale } from '../../lib/locale';

type Props = {
	readonly locale?: string;
};

const { locale = DEFAULT_LOCALE } = Astro.props;
const activeLocale = normalizeLocale(locale, {
	defaultLocale: DEFAULT_LOCALE,
	supportedLocales: SUPPORTED_LOCALES,
}) as SupportedLocale;

const SCREENS = [
	{ shot: MEDIA_SHOTS.crmDeals, titleKey: 'screenGallery.crmDealsTitle', noteKey: 'screenGallery.crmDealsNote' },
	{ shot: MEDIA_SHOTS.crmPipeline, titleKey: 'screenGallery.crmPipelineTitle', noteKey: 'screenGallery.crmPipelineNote' },
	{ shot: MEDIA_SHOTS.crmCalendar, titleKey: 'screenGallery.crmCalendarTitle', noteKey: 'screenGallery.crmCalendarNote' },
	{ shot: MEDIA_SHOTS.crmGallery, titleKey: 'screenGallery.crmGalleryTitle', noteKey: 'screenGallery.crmGalleryNote' },
	{ shot: MEDIA_SHOTS.crmForecast, titleKey: 'screenGallery.crmForecastTitle', noteKey: 'screenGallery.crmForecastNote' },
	{ shot: MEDIA_SHOTS.dashboard, titleKey: 'screenGallery.dashboardTitle', noteKey: 'screenGallery.dashboardNote' },
	{ shot: MEDIA_SHOTS.map, titleKey: 'screenGallery.mapTitle', noteKey: 'screenGallery.mapNote' },
	{ shot: MEDIA_SHOTS.timeline, titleKey: 'screenGallery.timelineTitle', noteKey: 'screenGallery.timelineNote' },
	{ shot: MEDIA_SHOTS.split, titleKey: 'screenGallery.splitTitle', noteKey: 'screenGallery.splitNote' },
	{ shot: MEDIA_SHOTS.analytics, titleKey: 'screenGallery.analyticsTitle', noteKey: 'screenGallery.analyticsNote' },
	{ shot: MEDIA_SHOTS.themes, titleKey: 'screenGallery.themesTitle', noteKey: 'screenGallery.themesNote' },
] as const;
---

<div class="screen-gallery">
	<div class="screen-gallery__head">
		<h3 class="screen-gallery__title" id="screen-gallery-title" data-i18n="screenGallery.title">{t(activeLocale, 'screenGallery.title')}</h3>
		<p class="screen-gallery__lede" data-i18n="screenGallery.lede">{t(activeLocale, 'screenGallery.lede')}</p>
	</div>
	<div class="screen-gallery__scroller" role="region" aria-labelledby="screen-gallery-title">
		<ul class="screen-gallery__list" role="list">
			{SCREENS.map((screen) => (
				<li class="screen-gallery__item">
					<figure class="screen-gallery__figure">
						<MediaSlot shot={screen.shot} frame="browser" sizes="(min-width: 1200px) 360px, (min-width: 768px) 46vw, 82vw" />
						<figcaption class="screen-gallery__caption">
							<span class="screen-gallery__name" data-i18n={screen.titleKey}>{t(activeLocale, screen.titleKey as any)}</span>
							<span class="screen-gallery__note" data-i18n={screen.noteKey}>{t(activeLocale, screen.noteKey as any)}</span>
						</figcaption>
					</figure>
				</li>
			))}
		</ul>
	</div>
</div>

<style is:global>
	.screen-gallery {
		display: grid;
		gap: 1.25rem;
		min-width: 0;
		margin-top: clamp(1.5rem, 5vw, 3.5rem);
	}

	.screen-gallery__head {
		display: grid;
		gap: 0.5rem;
		max-width: 60ch;
	}

	.screen-gallery__title {
		margin: 0;
		font-family: var(--system-font-sans);
		font-size: clamp(1.35rem, 2.2vw, 1.75rem);
		font-weight: 700;
		letter-spacing: -0.015em;
		color: var(--system-text-strong);
	}

	.screen-gallery__lede {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.5;
		color: var(--system-text-muted);
	}

	.screen-gallery__scroller {
		min-width: 0;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scroll-padding-inline: 1rem;
		-webkit-overflow-scrolling: touch;
	}

	.screen-gallery__list {
		display: flex;
		gap: 1.25rem;
		margin: 0;
		padding: 0 0 1rem;
		list-style: none;
	}

	@media (min-width: 768px) {
		.screen-gallery__scroller { overflow-x: visible; }
		.screen-gallery__list {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
			gap: 1.5rem;
			padding-bottom: 0;
		}
	}

	.screen-gallery__item {
		min-width: 82vw;
		max-width: 82vw;
		scroll-snap-align: center;
	}

	@media (min-width: 768px) {
		.screen-gallery__item {
			min-width: 0;
			max-width: none;
			scroll-snap-align: none;
		}
	}

	.screen-gallery__figure {
		display: flex;
		flex-direction: column;
		height: 100%;
		margin: 0;
		background: var(--system-surface);
		border: 1px solid var(--system-border);
		border-radius: var(--system-radius-md);
		overflow: hidden;
		transition: border-color var(--system-duration-base) var(--system-ease-standard);
	}

	.screen-gallery__figure:hover {
		border-color: var(--system-border-strong);
	}

	.screen-gallery__caption {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		padding: 1rem 1.1rem;
		margin-top: auto;
	}

	.screen-gallery__name {
		font-weight: 600;
		font-size: 0.95rem;
		color: var(--system-text-strong);
	}

	.screen-gallery__note {
		font-size: 0.85rem;
		color: var(--system-text-muted);
		line-height: 1.45;
	}
</style>