---
import Button from '../ui/Button.astro';
import PrismaticaLogo from '../brand/PrismaticaLogo.astro';
import LanguageSwitcher from '../ui/LanguageSwitcher.astro';
import HeaderMobileDrawer from './header/HeaderMobileDrawer.astro';
import { t, DEFAULT_LOCALE, SUPPORTED_LOCALES, type SupportedLocale } from '../../lib/i18n';
import { normalizeLocale } from '../../lib/locale';
import '../../styles/sections/_header-new.scss';

type Props = {
	readonly locale?: string;
};

const { locale = DEFAULT_LOCALE } = Astro.props;
const activeLocale = normalizeLocale(locale, {
	defaultLocale: DEFAULT_LOCALE,
	supportedLocales: SUPPORTED_LOCALES,
}) as SupportedLocale;

const navItems = [
	{ href: '#apps', i18nKey: 'nav.apps', label: t(activeLocale, 'nav.apps') },
	{ href: '#product', i18nKey: 'nav.product', label: t(activeLocale, 'nav.product') },
	{ href: '#pricing', i18nKey: 'nav.pricing', label: t(activeLocale, 'nav.pricing') },
	{ href: '/docs/', i18nKey: 'nav.docs', label: t(activeLocale, 'nav.docs') },
];
---

<header class="header-new" data-component="header-new">
	<div class="header-new__inner">
		<a class="header-new__brand" href="/" aria-label="Prismatica home">
			<span class="header-new__logo" aria-hidden="true"><PrismaticaLogo decorative /></span>
			<span class="header-new__wordmark">Prismatica</span>
		</a>

		<nav class="header-new__nav" aria-label="Primary">
			<ul class="header-new__list">
				{navItems.map((item) => (
					<li><a class="header-new__link" href={item.href} data-i18n={item.i18nKey}>{item.label}</a></li>
				))}
			</ul>
		</nav>

		<div class="header-new__actions">
			<LanguageSwitcher currentLocale={locale} />
			<button
				id="theme-toggle"
				class="header-new__theme"
				type="button"
				aria-label="Theme: Solar. Switch to Solar palette"
				title="Switch to Solar theme"
			>
				<svg class="header-icon--theme" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="8.25" fill="none" stroke="currentColor" stroke-width="1.6" /><path d="M12 3.75a8.25 8.25 0 0 1 0 16.5z" fill="currentColor" /><circle class="header-icon__swatch" cx="12" cy="12" r="3.4" /></svg>
				<span class="visually-hidden" data-theme-label>Theme: Solar</span>
			</button>
			<Button variant="ghost" size="sm" data-open-connect data-i18n="auth.signIn">{t(activeLocale, 'auth.signIn')}</Button>
			<Button variant="primary" size="sm" data-open-portal data-i18n="auth.startFree">{t(activeLocale, 'auth.startFree')}</Button>
		</div>

		<button
			class="header-new__menu"
			type="button"
			aria-expanded="false"
			aria-controls="header-new-menu"
			aria-label="Toggle navigation"
			data-header-toggle
		>
			<span aria-hidden="true"></span>
			<span aria-hidden="true"></span>
			<span aria-hidden="true"></span>
		</button>
	</div>

	<HeaderMobileDrawer navItems={navItems} locale={locale} activeLocale={activeLocale}>
		<LanguageSwitcher currentLocale={locale} isDrawer />
	</HeaderMobileDrawer>
</header>

<script>
	// Bundled (not is:inline) so it loads under a strict `script-src 'self'`
	// CSP — no inline-script allowance needed.
	import { bindSectionSpy } from '../../lib/section-spy';

	bindSectionSpy(document.querySelectorAll<HTMLAnchorElement>('.header-new__link'));

	(() => {
		const root = document.querySelector('[data-component="header-new"]');
		if (!root) return;
		const toggle = root.querySelector('[data-header-toggle]');
		const drawer = root.querySelector('#header-new-menu');
		if (!(toggle instanceof HTMLElement) || !(drawer instanceof HTMLElement)) return;

		const setOpen = (open: boolean) => {
			toggle.setAttribute('aria-expanded', String(open));
			drawer.hidden = !open;
			document.body.classList.toggle('drawer-open', open);
		};

		toggle.addEventListener('click', () => {
			const open = toggle.getAttribute('aria-expanded') === 'true';
			setOpen(!open);
		});

		// Mobile: close the drawer after choosing a section so the page is usable.
		drawer.querySelectorAll('a[href]').forEach((link) => {
			link.addEventListener('click', () => setOpen(false));
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
				setOpen(false);
				toggle.focus();
			}
		});
	})();
</script>