---
import Eyebrow from '../brand/Eyebrow.astro';
import { t, DEFAULT_LOCALE, SUPPORTED_LOCALES, type SupportedLocale } from '../../lib/i18n';
import { normalizeLocale } from '../../lib/locale';

type Props = {
	readonly locale?: string;
};

const { locale = DEFAULT_LOCALE } = Astro.props;
const activeLocale = normalizeLocale(locale, {
	defaultLocale: DEFAULT_LOCALE,
	supportedLocales: SUPPORTED_LOCALES,
}) as SupportedLocale;

const faqs = [
	{ qKey: 'faq.q1', aKey: 'faq.a1' },
	{ qKey: 'faq.q2', aKey: 'faq.a2' },
	{ qKey: 'faq.q3', aKey: 'faq.a3' },
	{ qKey: 'faq.q4', aKey: 'faq.a4' },
	{ qKey: 'faq.q5', aKey: 'faq.a5' },
] as const;
---

<section class="section section--sunken faq" id="faq">
	<div class="section__container faq__inner">
		<header class="section__head">
			<Eyebrow data-i18n="faq.eyebrow">{t(activeLocale, 'faq.eyebrow')}</Eyebrow>
			<h2 class="section__title" data-i18n="faq.title">{t(activeLocale, 'faq.title')}</h2>
		</header>

		<ul class="faq__list" role="list">
			{faqs.map((item, index) => (
				<li class="faq__item" data-scroll-rise>
					<details class="faq__details" open={index === 0}>
						<summary class="faq__summary">
							<span class="faq__question" data-i18n={item.qKey}>{t(activeLocale, item.qKey as any)}</span>
							<span class="faq__icon" aria-hidden="true">+</span>
						</summary>
						<p class="faq__answer" data-i18n={item.aKey}>{t(activeLocale, item.aKey as any)}</p>
					</details>
				</li>
			))}
		</ul>
	</div>
</section>

<style is:global>
	.faq__inner { max-width: 820px; margin: 0 auto; }
	.faq__list {
		display: grid;
		gap: 0.6rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.faq__details {
		border: 1px solid var(--system-border);
		border-radius: var(--system-radius-md);
		background: var(--system-surface);
		overflow: hidden;
	}
	.faq__summary {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		padding: 1rem 1.1rem;
		cursor: pointer;
		font-weight: 600;
		color: var(--system-text-strong);
		list-style: none;
	}
	.faq__summary::-webkit-details-marker { display: none; }
	.faq__summary:focus-visible {
		outline: 3px solid var(--system-focus-ring);
		outline-offset: -3px;
	}
	.faq__question { flex: 1; }
	.faq__icon {
		display: grid;
		place-items: center;
		width: 28px;
		height: 28px;
		border: 1px solid var(--system-border);
		border-radius: 50%;
		font-weight: 700;
		color: var(--system-text-muted);
		transition: transform var(--system-duration-base) var(--system-ease-standard);
	}
	.faq__details[open] .faq__icon { transform: rotate(45deg); }
	.faq__answer {
		margin: 0;
		padding: 0 1.1rem 1.1rem;
		color: var(--system-text);
		line-height: 1.6;
	}

	/* Answers glide open and shut instead of snapping. Needs ::details-content
	   and interpolate-size; elsewhere the selector is unknown, the rule drops,
	   and <details> toggles instantly as before. */
	@media (prefers-reduced-motion: no-preference) {
		.faq__details { interpolate-size: allow-keywords; }
		.faq__details::details-content {
			block-size: 0;
			opacity: 0;
			overflow-y: clip;
			transition:
				block-size 380ms var(--ease-premium),
				opacity 260ms linear,
				content-visibility 380ms allow-discrete;
		}
		.faq__details[open]::details-content {
			block-size: auto;
			opacity: 1;
		}
	}
</style>
