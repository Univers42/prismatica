---
import Eyebrow from '../brand/Eyebrow.astro';
import CanvasWindowsIllustration from '../svg/CanvasWindowsIllustration.astro';
import ScreenGallery from './ScreenGallery.astro';
import { t, DEFAULT_LOCALE, SUPPORTED_LOCALES, type SupportedLocale } from '../../lib/i18n';
import { normalizeLocale } from '../../lib/locale';

type Props = {
	readonly locale?: string;
};

const { locale = DEFAULT_LOCALE } = Astro.props;
const activeLocale = normalizeLocale(locale, {
	defaultLocale: DEFAULT_LOCALE,
	supportedLocales: SUPPORTED_LOCALES,
}) as SupportedLocale;
---

<section class="section section--surface canvas-windows" id="canvas">
	<div class="section__container canvas-windows__grid">
		<header class="canvas-windows__copy" data-reveal="head">
			<Eyebrow icon="✶" data-i18n="canvasWindows.eyebrow">{t(activeLocale, 'canvasWindows.eyebrow')}</Eyebrow>
			<h2 class="section__title canvas-windows__title" data-i18n="canvasWindows.title">{t(activeLocale, 'canvasWindows.title')}</h2>
			<p class="section__lede canvas-windows__lede">
				{t(activeLocale, 'canvasWindows.lede')}
			</p>
		</header>

		<figure class="canvas-windows__figure" data-scroll-grow>
			<CanvasWindowsIllustration /></figure>

		<ScreenGallery locale={activeLocale} />
	</div>
</section>

<style is:global>
	.canvas-windows__grid {
		display: grid;
		gap: clamp(1.5rem, 4vw, 3rem);
		align-items: center;
	}

	.canvas-windows__copy {
		display: grid;
		justify-items: center;
		gap: 0.9rem;
		max-width: 760px;
		margin-inline: auto;
		text-align: center;
	}

	.canvas-windows .canvas-windows__title {
		font-size: clamp(3rem, 7vw, 6.5rem);
		font-weight: 400;
		line-height: 0.9;
		color: var(--brand-canvas-text);
		text-shadow: 0 0 44px var(--brand-glow-primary);
	}

	.canvas-windows__lede {
		max-width: 68ch;
		text-align: center;
	}

	.canvas-windows__figure {
		position: relative;
		width: min(1080px, 100%);
		margin: 0 auto;
		padding: clamp(0.35rem, 1.2vw, 0.85rem);
		border: 1px solid var(--brand-canvas-line-strong);
		border-radius: clamp(1rem, 2vw, 1.6rem);
		background: var(--brand-canvas-bg);
		overflow: hidden;
	}
</style>