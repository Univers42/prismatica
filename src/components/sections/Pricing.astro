---
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
import Eyebrow from '../brand/Eyebrow.astro';
import { t, DEFAULT_LOCALE, SUPPORTED_LOCALES, type SupportedLocale } from '../../lib/i18n';
import { normalizeLocale } from '../../lib/locale';

type Props = {
	readonly locale?: string;
};

const { locale = DEFAULT_LOCALE } = Astro.props;
const activeLocale = normalizeLocale(locale, {
	defaultLocale: DEFAULT_LOCALE,
	supportedLocales: SUPPORTED_LOCALES,
}) as SupportedLocale;

const tiers = [
	{
		id: 'free',
		nameKey: 'pricing.freeName',
		priceKey: 'pricing.freePrice',
		cadenceKey: 'pricing.freeCadence',
		summaryKey: 'pricing.freeSummary',
		featureKeys: [
			'pricing.freeFeature1',
			'pricing.freeFeature2',
			'pricing.freeFeature3',
			'pricing.freeFeature4',
		],
		cta: { labelKey: 'pricing.freeCta', variant: 'secondary', action: 'open-portal-start' },
		emphasized: false,
	},
	{
		id: 'team',
		nameKey: 'pricing.teamName',
		priceKey: 'pricing.teamPrice',
		cadenceKey: 'pricing.teamCadence',
		summaryKey: 'pricing.teamSummary',
		featureKeys: [
			'pricing.teamFeature1',
			'pricing.teamFeature2',
			'pricing.teamFeature3',
			'pricing.teamFeature4',
		],
		cta: { labelKey: 'pricing.teamCta', variant: 'primary', action: 'open-portal-start' },
		emphasized: true,
	},
	{
		id: 'self',
		nameKey: 'pricing.selfName',
		priceKey: 'pricing.selfPrice',
		cadenceKey: 'pricing.selfCadence',
		summaryKey: 'pricing.selfSummary',
		featureKeys: [
			'pricing.selfFeature1',
			'pricing.selfFeature2',
			'pricing.selfFeature3',
			'pricing.selfFeature4',
		],
		cta: { labelKey: 'pricing.selfCta', variant: 'secondary', action: 'open-docs' },
		emphasized: false,
	},
] as const;
---

<section class="section section--sunken pricing" id="pricing">
	<div class="section__container">
		<header class="section__head">
			<Eyebrow data-i18n="pricing.eyebrow">{t(activeLocale, 'pricing.eyebrow')}</Eyebrow>
			<h2 class="section__title" data-i18n="pricing.title">{t(activeLocale, 'pricing.title')}</h2>
			<p class="section__lede" data-i18n="pricing.lede">{t(activeLocale, 'pricing.lede')}</p>
		</header>

		<div class="pricing__grid">
			{tiers.map((tier) => {
				const priceVal = t(activeLocale, tier.priceKey as any);
				return (
					<div data-scroll-grow class={`pricing__cell ${tier.emphasized ? 'pricing__cell--emphasized' : ''}`}>
						<Card variant="pricing" emphasized={tier.emphasized}>
							<div class="pricing__head">
								<h3 class="ui-card__title" data-i18n={tier.nameKey}>{t(activeLocale, tier.nameKey as any)}</h3>
								{tier.emphasized && <Badge tone="accent" size="sm" data-i18n="pricing.mostPopular">{t(activeLocale, 'pricing.mostPopular')}</Badge>}
							</div>
							<p class="pricing__price">
								<span
									class="pricing__amount"
									data-i18n={tier.priceKey}
									data-count-to={/^€(\d+)$/.exec(priceVal)?.[1]}
									data-count-prefix={/^€\d/.test(priceVal) ? '€' : undefined}
								>{priceVal}</span>
								<span class="pricing__cadence" data-i18n={tier.cadenceKey}>{t(activeLocale, tier.cadenceKey as any)}</span>
							</p>
							<p class="ui-card__lede" data-i18n={tier.summaryKey}>{t(activeLocale, tier.summaryKey as any)}</p>
							<ul class="pricing__features" role="list">
								{tier.featureKeys.map((fKey) => (<li data-i18n={fKey}>{t(activeLocale, fKey as any)}</li>))}
							</ul>
							<Button
								variant={tier.cta.variant as 'primary' | 'secondary'}
								size="md"
								full
								href={tier.cta.action === 'open-docs' ? '/docs/' : undefined}
								data-open-portal={tier.cta.action === 'open-portal-start' ? true : undefined}
								data-i18n={tier.cta.labelKey}
							>{t(activeLocale, tier.cta.labelKey as any)}</Button>
						</Card>
					</div>
				);
			})}
		</div>
	</div>
</section>

<style is:global>
	.pricing__grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 1.5rem;
		align-items: stretch;
	}
	.pricing__cell { height: 100%; }
	.pricing__cell .ui-card { height: 100%; }

	.pricing__cell--emphasized .ui-card {
		border-color: var(--brand-palette-primary);
		box-shadow:
			var(--system-shadow-3),
			0 0 0 1px color-mix(in srgb, var(--brand-palette-primary) 42%, transparent);
	}
	.pricing__cell--emphasized .ui-card::before {
		content: '';
		position: absolute;
		inset: 0 0 auto;
		height: 3px;
		border-radius: var(--system-radius-lg) var(--system-radius-lg) 0 0;
		background: linear-gradient(90deg,
			var(--brand-palette-primary),
			color-mix(in srgb, var(--brand-palette-primary) 55%, var(--brand-palette-secondary)));
	}

	.pricing__head {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.5rem;
	}
	.pricing__price {
		display: flex;
		align-items: baseline;
		gap: 0.4rem;
		margin: 0;
	}
	.pricing__amount {
		font-size: 2rem;
		font-weight: 700;
		color: var(--system-text-strong);
		letter-spacing: 0;
	}
	.pricing__cadence {
		font-size: 0.82rem;
		color: var(--system-text-muted);
	}
	.pricing__features {
		display: grid;
		gap: 0.45rem;
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: 0.92rem;
	}
	.pricing__features li::before {
		content: '';
		display: inline-block;
		width: 0.32em;
		height: 0.62em;
		margin: 0 0.75rem 0 0.2em;
		border: solid var(--system-success-text);
		border-width: 0 2px 2px 0;
		rotate: 45deg;
		translate: 0 -0.12em;
	}
</style>