---
import Card from '../ui/Card.astro';
import Eyebrow from '../brand/Eyebrow.astro';
import FeatureIcon from '../ui/FeatureIcon.astro';
import { t, DEFAULT_LOCALE, SUPPORTED_LOCALES, type SupportedLocale } from '../../lib/i18n';
import { normalizeLocale } from '../../lib/locale';

type Props = {
	readonly locale?: string;
};

const { locale = DEFAULT_LOCALE } = Astro.props;
const activeLocale = normalizeLocale(locale, {
	defaultLocale: DEFAULT_LOCALE,
	supportedLocales: SUPPORTED_LOCALES,
}) as SupportedLocale;

const features = [
	{ titleKey: 'featureTrio.authTitle', ledeKey: 'featureTrio.authLede', kind: 'auth' },
	{ titleKey: 'featureTrio.dbTitle', ledeKey: 'featureTrio.dbLede', kind: 'database' },
	{ titleKey: 'featureTrio.privacyTitle', ledeKey: 'featureTrio.privacyLede', kind: 'privacy' },
] as const;
---

<section class="section section--surface feature-trio" id="product">
	<div class="section__container">
		<header class="section__head">
			<Eyebrow data-i18n="featureTrio.eyebrow">{t(activeLocale, 'featureTrio.eyebrow')}</Eyebrow>
			<h2 class="section__title" data-i18n="featureTrio.title">{t(activeLocale, 'featureTrio.title')}</h2>
			<p class="section__lede" data-i18n="featureTrio.lede">{t(activeLocale, 'featureTrio.lede')}</p>
		</header>

		<div class="feature-trio__grid">
			{features.map((feature) => (
				<div data-scroll-grow>
					<Card variant="feature" class="feature-trio__card">
						<span class="feature-trio__icon" aria-hidden="true"><FeatureIcon name={feature.kind} /></span>
						<h3 class="ui-card__title" data-i18n={feature.titleKey}>{t(activeLocale, feature.titleKey as any)}</h3>
						<p class="ui-card__lede" data-i18n={feature.ledeKey}>{t(activeLocale, feature.ledeKey as any)}</p>
					</Card>
				</div>
			))}
		</div>
	</div>
</section>

<style is:global>
	.feature-trio__grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 1.5rem;
	}
	.feature-trio__card {
		height: 100%;
	}
	.feature-trio__icon {
		display: grid;
		place-items: center;
		width: 46px;
		height: 46px;
		border-radius: var(--system-radius-md);
		/* Warm accent chip that actually reads on a light card — the old
		   white-on-white box was invisible in the solar palette. */
		background: color-mix(in srgb, var(--brand-palette-primary) 14%, var(--system-surface));
		border: 1px solid color-mix(in srgb, var(--brand-palette-primary) 30%, transparent);
		color: var(--system-link);
		transition:
			background var(--system-duration-base) var(--system-ease-standard),
			border-color var(--system-duration-base) var(--system-ease-standard);
	}
	@media (hover: hover) {
		.feature-trio__card:hover .feature-trio__icon {
			background: color-mix(in srgb, var(--brand-palette-primary) 22%, var(--system-surface));
			border-color: color-mix(in srgb, var(--brand-palette-primary) 48%, transparent);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.feature-trio__icon { transition: none; }
	}
</style>
