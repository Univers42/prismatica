---
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
import Eyebrow from '../brand/Eyebrow.astro';
import { t, DEFAULT_LOCALE, SUPPORTED_LOCALES, type SupportedLocale } from '../../lib/i18n';
import { normalizeLocale } from '../../lib/locale';

type Props = {
	readonly locale?: string;
};

const { locale = DEFAULT_LOCALE } = Astro.props;
const activeLocale = normalizeLocale(locale, {
	defaultLocale: DEFAULT_LOCALE,
	supportedLocales: SUPPORTED_LOCALES,
}) as SupportedLocale;

const links = [
	{ href: '/docs/#guides/getting-started',                kind: 'quickstart', key: 'docsTeaser.linkQuickstart' },
	{ href: '/docs/#desktop/authentication-and-sessions',   kind: 'auth',       key: 'docsTeaser.linkAuth' },
	{ href: '/docs/#backend/kong-api-gateway',              kind: 'postgrest',  key: 'docsTeaser.linkPostgrest' },
	{ href: '/docs/#platform/gdpr-auth-security-migrations', kind: 'gdpr',       key: 'docsTeaser.linkGdpr' },
] as const;

const codeSample = `import { createClient } from '@grobase/js';

const baas = createClient({ url, anonKey });

const { data, error } = await baas
	.from('projects')
	.select('id, name, owner:users(email)')
	.eq('archived', false);`;
const codeLines = codeSample.split('\n');
---

<section class="section section--surface docs-teaser" id="docs">
	<div class="section__container docs-teaser__grid">
		<div data-reveal="head">
			<Eyebrow data-i18n="docsTeaser.eyebrow">{t(activeLocale, 'docsTeaser.eyebrow')}</Eyebrow>
			<h2 class="section__title docs-teaser__title" data-i18n="docsTeaser.title">{t(activeLocale, 'docsTeaser.title')}</h2>
			<p class="section__lede docs-teaser__lede" data-i18n="docsTeaser.lede">{t(activeLocale, 'docsTeaser.lede')}</p>
			<Button variant="primary" size="lg" href="/docs/" data-i18n="docsTeaser.openDocs">{t(activeLocale, 'docsTeaser.openDocs')}</Button>
		</div>

		<div class="docs-teaser__panel" data-scroll-grow>
			<Card variant="doc">
				<div class="docs-teaser__codewrap">
				<pre class="docs-teaser__code"><code>{codeLines.map((line, index) => (<>{index > 0 && '\n'}<span class="docs-teaser__line">{line}</span></>))}</code></pre>
				<button type="button" class="docs-teaser__copy" data-copy-code aria-label="Copy code sample">
					<svg class="docs-teaser__copy-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
						<rect x="9" y="9" width="11" height="11" rx="2.5" />
						<path d="M15 5.5A2.5 2.5 0 0 0 12.5 3h-6A2.5 2.5 0 0 0 4 5.5v6A2.5 2.5 0 0 0 6.5 14" />
					</svg>
					<span class="docs-teaser__copy-label" data-copy-label data-i18n="docsTeaser.copy" data-copied-label={t(activeLocale, 'docsTeaser.copied')}>{t(activeLocale, 'docsTeaser.copy')}</span>
				</button>
				</div>
				<ul class="docs-teaser__links" role="list">
					{links.map((link) => (
						<li><a href={link.href}>
							<span class="docs-teaser__label" data-i18n={link.key}>{t(activeLocale, link.key as any)}</span>
							<span class="docs-teaser__arrow" aria-hidden="true">→</span>
						</a></li>
					))}
				</ul>
			</Card>
		</div>
	</div>
</section>
<style is:global>
	.docs-teaser__grid {
		display: grid;
		grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
		gap: clamp(2rem, 4vw, 3rem);
		align-items: center;
	}
	@media (max-width: 920px) {
		.docs-teaser__grid { grid-template-columns: minmax(0, 1fr); }
	}
	.docs-teaser__title { text-align: left; }
	.docs-teaser__lede {
		text-align: left;
		max-width: 50ch;
		margin-bottom: 1.25rem;
	}
	.docs-teaser__codewrap { position: relative; min-width: 0; }
	.docs-teaser__code {
		margin: 0;
		padding: 1rem;
		background: var(--system-surface-sunken);
		border: 1px solid var(--system-border);
		border-radius: var(--system-radius-md);
		font-family: var(--system-font-mono);
		font-size: 0.84rem;
		line-height: 1.55;
		color: var(--system-text);
		overflow-x: auto;
	}
	.docs-teaser__copy {
		position: absolute;
		top: 0.5rem;
		right: 0.5rem;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		min-height: 32px;
		padding: 0.3rem 0.6rem;
		border: 1px solid var(--system-border);
		border-radius: var(--system-radius-sm);
		background: color-mix(in srgb, var(--system-surface) 90%, transparent);
		color: var(--system-text-muted);
		font: 600 var(--system-text-2xs) / 1 var(--system-font-sans);
		letter-spacing: 0.02em;
		cursor: pointer;
		transition:
			background var(--system-duration-base) var(--system-ease-standard),
			border-color var(--system-duration-base) var(--system-ease-standard),
			color var(--system-duration-base) var(--system-ease-standard);
	}
	.docs-teaser__copy:hover {
		border-color: var(--system-border-strong);
		color: var(--system-text-strong);
		background: var(--system-surface);
	}
	.docs-teaser__copy:focus-visible {
		outline: 3px solid var(--system-focus-ring);
		outline-offset: 2px;
	}
	.docs-teaser__copy.is-copied {
		color: var(--system-success-text);
		border-color: var(--system-success-border);
	}
	.docs-teaser__copy-icon { width: 15px; height: 15px; stroke: currentColor; stroke-width: 1.75; }
	.docs-teaser__arrow {
		margin-left: 0.35em;
		transition: transform var(--system-duration-base) var(--system-ease-standard);
	}
	.docs-teaser__links a:hover .docs-teaser__arrow { transform: translateX(3px); }
	@media (prefers-reduced-motion: reduce) {
		.docs-teaser__copy,
		.docs-teaser__arrow { transition: none; }
		.docs-teaser__links a:hover .docs-teaser__arrow { transform: none; }
	}
	.docs-teaser__links {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 0.4rem 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.docs-teaser__links a {
		display: inline-flex;
		min-height: 36px;
		align-items: center;
		color: var(--system-link);
		text-decoration: none;
		font-weight: 500;
	}
	.docs-teaser__links a:hover { color: var(--system-link-hover); text-decoration: underline; }
	.docs-teaser__links a:focus-visible {
		outline: 3px solid var(--system-focus-ring);
		outline-offset: 2px;
		border-radius: var(--system-radius-sm);
	}

	/* The sample types itself in once the panel has landed
	   (lib/scroll-reveal.ts): each line wipes in left to right, in order. */
	.docs-teaser__line { display: inline-block; }
	@media (prefers-reduced-motion: no-preference) {
		:root:not(.motion-paused) .docs-teaser__panel.reveal-prep .docs-teaser__line {
			opacity: 0;
			clip-path: inset(0 100% 0 0);
			transition:
				opacity 260ms linear,
				clip-path 420ms var(--ease-premium);
			transition-delay: calc(var(--reveal-delay, 0ms) + 380ms + var(--line, 0) * 110ms);
		}
		:root:not(.motion-paused) .docs-teaser__panel.is-revealed .docs-teaser__line {
			opacity: 1;
			clip-path: inset(0 -1ch 0 0);
		}
		.docs-teaser__line:nth-child(2) { --line: 1; }
		.docs-teaser__line:nth-child(3) { --line: 2; }
		.docs-teaser__line:nth-child(4) { --line: 3; }
		.docs-teaser__line:nth-child(5) { --line: 4; }
		.docs-teaser__line:nth-child(6) { --line: 5; }
		.docs-teaser__line:nth-child(n + 8) { --line: 7; }
	}
</style>

<script>
	(() => {
		for (const btn of document.querySelectorAll('[data-copy-code]')) {
			const wrap = btn.closest('.docs-teaser__codewrap');
			const code = wrap?.querySelector('code');
			const label = btn.querySelector('[data-copy-label]');
			if (!code || !(label instanceof HTMLElement)) continue;
			btn.addEventListener('click', async () => {
				try {
					await navigator.clipboard.writeText(code.textContent ?? '');
					const initialText = label.textContent || 'Copy';
					const copiedText = label.getAttribute('data-copied-label') || 'Copied';
					label.textContent = copiedText;
					btn.classList.add('is-copied');
					window.setTimeout(() => {
						label.textContent = initialText;
						btn.classList.remove('is-copied');
					}, 1600);
				} catch {}
			});
		}
	})();
</script>