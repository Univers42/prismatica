---
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
import Eyebrow from '../brand/Eyebrow.astro';

const links = [
	{ href: '/docs/quickstart', kind: 'quickstart' },
	{ href: '/docs/auth',       kind: 'auth' },
	{ href: '/docs/postgrest',  kind: 'postgrest' },
	{ href: '/docs/gdpr',       kind: 'gdpr' },
];
---

<section class="section section--surface docs-teaser" id="docs">
	<div class="section__container docs-teaser__grid">
		<div data-scroll-rise>
			<Eyebrow>Built for engineers</Eyebrow>
			<h2 class="section__title docs-teaser__title">Read the docs.<br/>Ship in an afternoon.</h2>
			<p class="section__lede docs-teaser__lede">
				Every endpoint typed. Every recipe runnable. Every page versioned.
			</p>
			<Button variant="primary" size="lg" href="/docs">Open the docs</Button>
		</div>

		<div class="docs-teaser__panel" data-scroll-grow>
			<Card variant="doc">
				<div class="docs-teaser__codewrap">
				<pre class="docs-teaser__code"><code>{`import { createClient } from '@grobase/js';

const baas = createClient({ url, anonKey });

const { data, error } = await baas
	.from('projects')
	.select('id, name, owner:users(email)')
	.eq('archived', false);`}</code></pre>
				<button type="button" class="docs-teaser__copy" data-copy-code aria-label="Copy code sample">
					<svg class="docs-teaser__copy-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
						<rect x="9" y="9" width="11" height="11" rx="2.5" />
						<path d="M15 5.5A2.5 2.5 0 0 0 12.5 3h-6A2.5 2.5 0 0 0 4 5.5v6A2.5 2.5 0 0 0 6.5 14" />
					</svg>
					<span class="docs-teaser__copy-label" data-copy-label>Copy</span>
				</button>
				</div>
				<ul class="docs-teaser__links" role="list">
					{links.map((link) => (
						<li><a href={link.href}>
							<span class="docs-teaser__label">
								{link.kind === 'quickstart' && <>Quickstart</>}
								{link.kind === 'auth' && <><span class="term" title="Authentication: proving who a user is before giving access.">Auth</span> &amp; sessions</>}
								{link.kind === 'postgrest' && <>PostgREST recipes</>}
								{link.kind === 'gdpr' && <><abbr title="General Data Protection Regulation: European privacy law covering personal data.">GDPR</abbr> runbook</>}
							</span>
							<span class="docs-teaser__arrow" aria-hidden="true">→</span>
						</a></li>
					))}
				</ul>
			</Card>
		</div>
	</div>
</section>

<style is:global>
	.docs-teaser__grid {
		display: grid;
		grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
		gap: clamp(2rem, 4vw, 3rem);
		align-items: center;
	}
	@media (max-width: 920px) {
		.docs-teaser__grid { grid-template-columns: 1fr; }
	}
	.docs-teaser__title { text-align: left; }
	.docs-teaser__lede {
		text-align: left;
		max-width: 50ch;
		margin-bottom: 1.25rem;
	}
	.docs-teaser__codewrap { position: relative; }
	.docs-teaser__code {
		margin: 0;
		padding: 1rem;
		background: var(--system-surface-sunken);
		border: 1px solid var(--system-border);
		border-radius: var(--system-radius-md);
		font-family: var(--system-font-mono);
		font-size: 0.84rem;
		line-height: 1.55;
		color: var(--system-text);
		overflow-x: auto;
	}
	.docs-teaser__copy {
		position: absolute;
		top: 0.5rem;
		right: 0.5rem;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		min-height: 32px;
		padding: 0.3rem 0.6rem;
		border: 1px solid var(--system-border);
		border-radius: var(--system-radius-sm);
		background: color-mix(in srgb, var(--system-surface) 90%, transparent);
		color: var(--system-text-muted);
		font: 600 var(--system-text-2xs) / 1 var(--system-font-sans);
		letter-spacing: 0.02em;
		cursor: pointer;
		transition:
			background var(--system-duration-base) var(--system-ease-standard),
			border-color var(--system-duration-base) var(--system-ease-standard),
			color var(--system-duration-base) var(--system-ease-standard);
	}
	.docs-teaser__copy:hover {
		border-color: var(--system-border-strong);
		color: var(--system-text-strong);
		background: var(--system-surface);
	}
	.docs-teaser__copy:focus-visible {
		outline: 3px solid var(--system-focus-ring);
		outline-offset: 2px;
	}
	.docs-teaser__copy.is-copied {
		color: var(--system-success-text);
		border-color: var(--system-success-border);
	}
	.docs-teaser__copy-icon { width: 15px; height: 15px; stroke: currentColor; stroke-width: 1.75; }
	.docs-teaser__arrow {
		margin-left: 0.35em;
		transition: transform var(--system-duration-base) var(--system-ease-standard);
	}
	.docs-teaser__links a:hover .docs-teaser__arrow { transform: translateX(3px); }
	@media (prefers-reduced-motion: reduce) {
		.docs-teaser__copy,
		.docs-teaser__arrow { transition: none; }
		.docs-teaser__links a:hover .docs-teaser__arrow { transform: none; }
	}
	.docs-teaser__links {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 0.4rem 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.docs-teaser__links a {
		display: inline-flex;
		min-height: 36px;
		align-items: center;
		color: var(--system-link);
		text-decoration: none;
		font-weight: 500;
	}
	.docs-teaser__links a:hover { color: var(--system-link-hover); text-decoration: underline; }
	.docs-teaser__links a:focus-visible {
		outline: 3px solid var(--system-focus-ring);
		outline-offset: 2px;
		border-radius: var(--system-radius-sm);
	}
</style>

<script>
	// Bundled (not is:inline) so it runs under the strict production
	// `script-src 'self'` CSP with no inline-hash allowance needed.
	(() => {
		for (const btn of document.querySelectorAll('[data-copy-code]')) {
			const wrap = btn.closest('.docs-teaser__codewrap');
			const code = wrap?.querySelector('code');
			const label = btn.querySelector('[data-copy-label]');
			if (!code || !(label instanceof HTMLElement)) continue;
			btn.addEventListener('click', async () => {
				try {
					await navigator.clipboard.writeText(code.textContent ?? '');
					label.textContent = 'Copied';
					btn.classList.add('is-copied');
					window.setTimeout(() => {
						label.textContent = 'Copy';
						btn.classList.remove('is-copied');
					}, 1600);
				} catch {
					/* clipboard unavailable (insecure context / denied) */
				}
			});
		}
	})();
</script>
