Prismatica - https://prismatica.example
"
`;

exports[`message accountLinked > matches its HTML and text snapshots > html 1`] = `
"<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
