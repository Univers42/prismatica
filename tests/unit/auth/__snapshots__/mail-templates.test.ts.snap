<p style="margin:0 0 16px 0;font-size:16px;line-height:1.5;color:#15151A;">Someone, probably you, tried to create a Prismatica account for ines@arlet.test. This address already has one, so nothing was created.</p>
<table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td bgcolor="#B93A0C" style="border-radius:4px;background-color:#B93A0C;"><a href="https://prismatica.example" style="display:inline-block;padding:12px 20px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;font-weight:600;line-height:1.25;color:#FFFFFF;text-decoration:none;border-radius:4px;">Sign in</a></td></tr></table>
<p style="margin:16px 0 0 0;font-size:14px;line-height:1.5;color:#56565F;">Forgot the password? Choose <strong>Forgot password</strong> in the sign-in window and we will send you a reset link.</p>
</td></tr>
<tr><td style="padding:20px 0 0 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:1.5;color:#56565F;">You did not try to sign up? Ignore this message; your account has not changed. Sent by <a href="https://prismatica.example" style="color:#56565F;">Prismatica</a> to ines@arlet.test.</td></tr>
</table>
</td></tr>
</table>
</body>
</html>
"
`;

exports[`message accountExists > matches its HTML and text snapshots > subject 1`] = `"You already have an account"`;

exports[`message accountExists > matches its HTML and text snapshots > text 1`] = `
"You already have an account

Someone, probably you, tried to create a Prismatica account for ines@arlet.test. This address already has one, so nothing was created.

