{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "pnpm install --no-frozen-lockfile || true",
  "buildCommand": "pnpm exec astro build",
  "outputDirectory": "dist",
  "build": {
    "env": {
      "TRACK_BINOCLE_IN_DOCKER": "1",
      "PUBLIC_SITE_URL": "https://prismatica-eta.vercel.app",
      "PUBLIC_OSIONOS_APP_URL": "https://baas.tail10f2ea.ts.net:8443",
      "PUBLIC_AUTH_REQUIRE_EMAIL_VERIFICATION": "true"
    }
  },
  "rewrites": [
    { "source": "/api/auth/:path*", "destination": "https://baas.tail10f2ea.ts.net:8443/api/auth/:path*" },
    { "source": "/api/newsletter/:path*", "destination": "https://baas.tail10f2ea.ts.net:8443/api/newsletter/:path*" },
    { "source": "/auth/:path*", "destination": "https://baas.tail10f2ea.ts.net/auth/:path*" },
    { "source": "/query/:path*", "destination": "https://baas.tail10f2ea.ts.net/query/:path*" },
    { "source": "/storage/:path*", "destination": "https://baas.tail10f2ea.ts.net/storage/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
